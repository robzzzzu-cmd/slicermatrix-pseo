            ))}
          </div>
        </div>

        <!-- Right 4 Cols: Complete Tabular Specification Register -->
        <div class="lg:col-span-4 divide-y divide-neutral-200 bg-neutral-50">
          <div class="p-6 bg-neutral-100">
            <span class="bg-neutral-950 text-white font-mono uppercase text-xs px-2.5 py-1">
              PARAMETER REGISTER
            </span>
            <h3 class="text-xl font-black uppercase tracking-tight text-neutral-950 mt-2">
              Slicer Cheat Sheet
            </h3>
          </div>

          <dl class="divide-y divide-neutral-200 text-xs font-mono tabular-nums">
            <div class="px-6 py-3.5 flex justify-between">
              <dt class="text-neutral-500 uppercase">FIRST LAYER SPEED</dt>
              <dd class="font-bold text-neutral-950">{page.firstLayerSpeedMmS} MM/S</dd>
            </div>
            <div class="px-6 py-3.5 flex justify-between">
              <dt class="text-neutral-500 uppercase">NOZZLE TEMPERATURE</dt>
              <dd class="font-bold text-orange-600">{deterministicMath.recommendedNozzleTempC} °C</dd>
            </div>
            <div class="px-6 py-3.5 flex justify-between">
              <dt class="text-neutral-500 uppercase">BED TEMPERATURE</dt>
              <dd class="font-bold text-neutral-950">{deterministicMath.recommendedBedTempC} °C</dd>
            </div>
            <div class="px-6 py-3.5 flex justify-between">
              <dt class="text-neutral-500 uppercase">PART COOLING FAN</dt>
              <dd class="font-bold text-neutral-950">{page.coolingFanMinPct}% – {page.coolingFanMaxPct}%</dd>
            </div>
            <div class="px-6 py-3.5 flex justify-between">
              <dt class="text-neutral-500 uppercase">RETRACTION LENGTH</dt>
              <dd class="font-bold text-neutral-950">{page.retractionDistanceMm} MM</dd>
            </div>
            <div class="px-6 py-3.5 flex justify-between">
              <dt class="text-neutral-500 uppercase">RETRACTION VELOCITY</dt>
              <dd class="font-bold text-neutral-950">{page.retractionSpeedMmS} MM/S</dd>
            </div>
            <div class="px-6 py-3.5 flex justify-between">
              <dt class="text-neutral-500 uppercase">VOLUMETRIC LIMIT</dt>
              <dd class="font-bold text-emerald-700">{deterministicMath.effectiveVolumetricFlowMm3s} MM³/S</dd>
            </div>
            <div class="p-6">
              <dt class="text-neutral-500 uppercase mb-1.5">RECOMMENDED BUILD SURFACE</dt>
              <dd class="font-bold text-neutral-950 bg-white p-3 border border-neutral-300">
                {page.bedSurfaceRecommendation}
              </dd>
            </div>
          </dl>
        </div>
      </section>

      <!-- 05. FAILURE MODE & TROUBLESHOOTING MATRIX -->
      <section class="divide-y divide-neutral-200">
        <div class="p-6 sm:px-8 bg-neutral-100">
          <span class="bg-neutral-950 text-white font-mono uppercase text-xs px-2.5 py-1">
            05 // DIAGNOSTIC PROTOCOL
          </span>
          <h2 class="text-xl font-black uppercase tracking-tight text-neutral-950 mt-2">
            {printer.name} × {filament.name} Troubleshooting Matrix
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-neutral-200 bg-white">
          {page.troubleshootingMatrix.map((item, idx) => (
            <div class="p-6 sm:p-8 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-[11px] font-mono tabular-nums uppercase text-red-700 font-bold mb-2">
                  <span>FAULT MODE 05.{idx + 1}</span>
                  <span>DIAGNOSTIC</span>
                </div>
                <h3 class="font-black text-neutral-950 uppercase text-base mb-3 tracking-tight">
                  {item.issue}
                </h3>
                <p class="text-xs text-neutral-600 mb-6 leading-relaxed">
                  <strong class="font-mono uppercase text-neutral-950">ROOT CAUSE:</strong> {item.rootCause}
                </p>
              </div>
              <div class="pt-4 border-t border-neutral-200">
                <span class="block text-[11px] font-mono uppercase text-emerald-700 font-bold mb-1">
                  CORRECTIVE ENGINEERING ACTION
                </span>
                <p class="text-xs sm:text-sm text-neutral-900 leading-relaxed">{item.exactFix}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 06. TECHNICAL FAQ SPECIFICATION (JSON-LD BACKED) -->
      <section class="divide-y divide-neutral-200">
        <div class="p-6 sm:px-8 bg-neutral-100">
          <span class="bg-neutral-950 text-white font-mono uppercase text-xs px-2.5 py-1">
            06 // OPERATOR Q&A
          </span>
          <h2 class="text-xl font-black uppercase tracking-tight text-neutral-950 mt-2">
            Frequently Asked Engineering Questions
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-neutral-200 bg-white">
          {page.faq.map((item, idx) => (
            <div class="p-6 sm:p-8 border-b border-neutral-200">
              <div class="text-[11px] font-mono tabular-nums text-neutral-400 uppercase mb-1">
                QUERY 06.{idx + 1}
              </div>
              <h3 class="font-bold text-neutral-950 text-base mb-2">{item.question}</h3>
              <p class="text-sm text-neutral-700 leading-relaxed">{item.answer}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- 07. INTERNAL LINK MESH & ADJACENT MATRIX COMBINATIONS -->
      <section aria-label="Internal Link Mesh" class="divide-y divide-neutral-200">
        <div class="p-6 sm:px-8 bg-neutral-100 flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <span class="bg-neutral-950 text-white font-mono uppercase text-xs px-2.5 py-1">
              07 // CONNECTED SPECIFICATION MESH
            </span>
            <h2 class="text-xl font-black uppercase tracking-tight text-neutral-950 mt-2">
              Adjacent Printer × Polymer Calibration Sheets
            </h2>
          </div>
          <div class="flex flex-wrap gap-2">
            <a
              href={withBase(`/printer/${printer.slug}/`)}
              class="bg-neutral-950 hover:bg-neutral-800 text-white font-medium px-4 py-2 text-sm uppercase tracking-wider font-mono transition-none"
            >
              ALL {printer.name} PROFILES →
            </a>
            <a
              href={withBase(`/filament/${filament.slug}/`)}
              class="bg-neutral-950 hover:bg-neutral-800 text-white font-medium px-4 py-2 text-sm uppercase tracking-wider font-mono transition-none"
            >
              ALL {filament.name} PRINTERS →
            </a>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-neutral-200 bg-white">
          {neighbors.map((neighbor, idx) => {
            const href = neighbor.isGenerated
              ? withBase(`/${neighbor.slug}/`)
              : withBase(`/printer/${neighbor.printer.slug}/#${neighbor.slug}`);
            return (
              <a
                href={href}
                class="group p-6 hover:bg-neutral-100 transition-none flex flex-col justify-between border-b border-neutral-200"
              >
                <div>
                  <div class="flex items-center justify-between text-[11px] font-mono tabular-nums text-neutral-500 uppercase mb-1">
                    <span>ADJ.0{idx + 1} // {neighbor.printer.name}</span>
                    <span class="text-emerald-700 font-bold">
                      {neighbor.deterministicMath.effectiveVolumetricFlowMm3s} MM³/S
                    </span>
                  </div>
                  <div class="font-black text-base uppercase text-neutral-950 group-hover:text-orange-600 tracking-tight">
                    {neighbor.printer.name} × {neighbor.filament.name}
                  </div>
                </div>
                <div class="mt-4 pt-3 border-t border-neutral-200 flex items-center justify-between text-xs font-mono tabular-nums text-neutral-600">
                  <span>
                    {neighbor.deterministicMath.recommendedNozzleTempC}°C / {neighbor.deterministicMath.recommendedBedTempC}°C
                  </span>
                  <span class="font-bold text-neutral-950 group-hover:text-orange-600">
                    {neighbor.deterministicMath.calculatedMaxPrintSpeedMmS} MM/S →
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    </div>
  </div>

  <!-- Client-Side Interactive Calculator & OrcaSlicer JSON Preset Generator -->
  <script>
    function initSlicerPageInteractions() {
      // 1. One-Click Download .json OrcaSlicer Filament Preset
      const downloadBtn = document.getElementById('download-orca-preset-btn');
      if (downloadBtn) {
        downloadBtn.addEventListener('click', () => {
          const slug = downloadBtn.getAttribute('data-slug') || 'preset';
          const rawPreset = downloadBtn.getAttribute('data-preset') || '{}';
          try {
            const parsed = JSON.parse(rawPreset);
            const prettyJson = JSON.stringify(parsed, null, 2);
            const blob = new Blob([prettyJson], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `${slug}-orcaslicer.json`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
          } catch (e) {
            console.error('Failed to build OrcaSlicer preset download', e);
          }
        });
      }

      // 2. Interactive Nozzle & Layer Speed Calculator
      const calcSection = document.getElementById('speed-calculator');
      if (!calcSection) return;

      const effectiveFlow = parseFloat(calcSection.getAttribute('data-flow') || '14');
      const isAbrasive = calcSection.getAttribute('data-abrasive') === 'true';

      let currentNozzle = 0.4;
      const slider = document.getElementById('layer-height-slider') as HTMLInputElement | null;
      const layerDisplay = document.getElementById('layer-height-display');
      const speedDisplay = document.getElementById('calc-max-speed');
      const lineWidthNote = document.getElementById('calc-line-width-note');
      const printTimeDisplay = document.getElementById('calc-print-time');
      const clogRiskEl = document.getElementById('calc-clog-risk');
      const clogSubEl = document.getElementById('calc-clog-sub');
      const clogBanner = document.getElementById('calc-clog-warning-banner');
      const nozzleButtons = document.querySelectorAll('.nozzle-select-btn');

      function recalculate() {
        const layerHeight = slider ? parseFloat(slider.value) : 0.2;
        if (layerDisplay) {
          layerDisplay.textContent = `${layerHeight.toFixed(2)} MM`;
        }

        const lineWidth = currentNozzle * 1.05;
        const safeMaxSpeed = Math.round(effectiveFlow / (layerHeight * lineWidth));

        if (speedDisplay) {
          speedDisplay.textContent = String(safeMaxSpeed);
        }
        if (lineWidthNote) {
          lineWidthNote.textContent = `EXTRUSION WIDTH (105%): ${lineWidth.toFixed(2)} MM @ ${layerHeight.toFixed(2)} MM LAYER`;
        }

        const actualAvgFlow = effectiveFlow * 0.65;
        const totalSeconds = Math.round(80645 / Math.max(1, actualAvgFlow));
        const hours = Math.floor(totalSeconds / 3600);
        const mins = Math.round((totalSeconds % 3600) / 60);
        if (printTimeDisplay) {
          printTimeDisplay.textContent = hours > 0 ? `${hours}h ${mins}m` : `${mins}m`;
        }

        if (clogRiskEl && clogSubEl && clogBanner) {
          if (currentNozzle <= 0.2 && isAbrasive) {
            clogRiskEl.textContent = '▲ CRITICAL JAM HAZARD';
            clogRiskEl.className = 'text-sm font-mono tabular-nums font-bold text-red-600 mt-2 uppercase';
            clogSubEl.textContent = '0.2MM + ABRASIVE FIBRES CLOG';
            clogBanner.classList.remove('hidden');
          } else if (currentNozzle === 0.4 && isAbrasive) {
            clogRiskEl.textContent = '◆ ELEVATED WEAR RISK';
            clogRiskEl.className = 'text-sm font-mono tabular-nums font-bold text-amber-600 mt-2 uppercase';
            clogSubEl.textContent = 'REQUIRE HARDENED 0.4/0.6MM';
            clogBanner.classList.add('hidden');
          } else if (layerHeight > currentNozzle * 0.75) {
            clogRiskEl.textContent = '◆ EXTRUSION CEILING';
            clogRiskEl.className = 'text-sm font-mono tabular-nums font-bold text-amber-600 mt-2 uppercase';
            clogSubEl.textContent = 'LAYER EXCEEDS 75% ORIFICE Ø';
            clogBanner.classList.add('hidden');
          } else {
            clogRiskEl.textContent = '● NOMINAL CLEARANCE';
            clogRiskEl.className = 'text-sm font-mono tabular-nums font-bold text-emerald-700 mt-2 uppercase';
            clogSubEl.textContent = 'UNRESTRICTED MELT ZONE';
            clogBanner.classList.add('hidden');
          }
        }
      }

      nozzleButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const size = parseFloat(btn.getAttribute('data-nozzle') || '0.4');
          currentNozzle = size;

          nozzleButtons.forEach((b) => {
            b.className =
              'nozzle-select-btn py-3.5 px-4 font-mono tabular-nums font-bold text-sm uppercase cursor-pointer transition-none bg-neutral-50 text-neutral-950 hover:bg-neutral-200';
          });
          btn.className =
            'nozzle-select-btn py-3.5 px-4 font-mono tabular-nums font-bold text-sm uppercase cursor-pointer transition-none bg-neutral-950 text-white';

          recalculate();
        });
      });

      if (slider) {
        slider.addEventListener('input', recalculate);
      }

      recalculate();
    }

    initSlicerPageInteractions();
  </script>
</BaseLayout>
