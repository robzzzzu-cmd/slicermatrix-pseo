---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PUBLIC_AMAZON_AFFILIATE_TAG } from '../config';
import {
  loadGeneratedPages,
  loadAllSeeds,
  type PageProfileData,
} from '../utils/data';

export function getStaticPaths() {
  const pages = loadGeneratedPages();
  const allSeeds = loadAllSeeds();
  const generatedMap = new Map(pages.map((p) => [p.slug, p]));

  return pages.map((page) => {
    const otherGenerated = pages.filter((p) => p.slug !== page.slug);
    const samePrinterSeeds = allSeeds
      .filter((s) => s.printer.slug === page.printer.slug && s.slug !== page.slug)
      .slice(0, 4);
    const sameFilamentSeeds = allSeeds
      .filter((s) => s.filament.slug === page.filament.slug && s.slug !== page.slug)
      .slice(0, 4);

    const neighborsMap = new Map();
    for (const item of [...otherGenerated, ...samePrinterSeeds, ...sameFilamentSeeds]) {
      if (!neighborsMap.has(item.slug) && neighborsMap.size < 6) {
        neighborsMap.set(item.slug, {
          ...item,
          isGenerated: generatedMap.has(item.slug),
        });
      }
    }

    return {
      params: { slug: page.slug },
      props: {
        page,
        neighbors: Array.from(neighborsMap.values()),
      },
    };
  });
}

interface Props {
  page: PageProfileData;
  neighbors: Array<PageProfileData & { isGenerated?: boolean }>;
}

const { page, neighbors } = Astro.props;
const { printer, filament, deterministicMath } = page;
const AFFILIATE_TAG = PUBLIC_AMAZON_AFFILIATE_TAG;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p: string) => `${BASE}${p.startsWith('/') ? p : '/' + p}`;

// Parametric Amazon URLs
const primaryFilamentAmazonUrl = `https://www.amazon.com/s?k=${encodeURIComponent(
  filament.name + ' 1.75mm 1kg filament'
)}&tag=${AFFILIATE_TAG}`;

const hardenedNozzleAmazonUrl = `https://www.amazon.com/s?k=${encodeURIComponent(
  printer.name + ' hardened steel nozzle 0.4mm 0.6mm'
)}&tag=${AFFILIATE_TAG}`;

const filamentDryerAmazonUrl = `https://www.amazon.com/s?k=${encodeURIComponent(
  '3D filament dryer box 70C Creality Space Pi Sunlu S2'
)}&tag=${AFFILIATE_TAG}`;

const buildPlateGlueAmazonUrl = `https://www.amazon.com/s?k=${encodeURIComponent(
  printer.name + ' textured PEI build plate liquid glue'
)}&tag=${AFFILIATE_TAG}`;

const isAbrasiveOrComposite =
  deterministicMath.requiresHardenedNozzleUpgrade ||
  filament.isAbrasive ||
  /cf|gf|glow|wood|carbon|glass/i.test(filament.name) ||
  /cf|gf|glow|wood/i.test(filament.materialType);

const pageTitle = `Best ${printer.name} Settings for ${filament.name} (OrcaSlicer Profile)`;
const pageDescription = page.heroSummary;

// FAQPage JSON-LD Schema
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

// Pre-build OrcaSlicer preset JSON payload for client download
const orcaPresetPayload = {
  type: 'filament',
  name: `${filament.name} @${printer.name} (SlicerMatrix)`,
  inherits: `Generic ${filament.materialType}`,
  from: 'User',
  instantiation: 'true',
  filament_id: page.slug.slice(0, 16),
  filament_type: [filament.materialType],
  filament_vendor: [filament.brand],
  nozzle_temperature: [String(deterministicMath.recommendedNozzleTempC)],
  nozzle_temperature_initial_layer: [
    String(Math.min(printer.maxNozzleTempC, deterministicMath.recommendedNozzleTempC + 5)),
  ],
  nozzle_temperature_range_low: [String(filament.minNozzleTempC)],
  nozzle_temperature_range_high: [String(filament.maxNozzleTempC)],
  hot_plate_temp: [String(deterministicMath.recommendedBedTempC)],
  hot_plate_temp_initial_layer: [String(deterministicMath.recommendedBedTempC)],
  textured_plate_temp: [String(deterministicMath.recommendedBedTempC)],
  textured_plate_temp_initial_layer: [String(deterministicMath.recommendedBedTempC)],
  filament_max_volumetric_speed: [String(deterministicMath.effectiveVolumetricFlowMm3s)],
  filament_retraction_length: [String(page.retractionDistanceMm)],
  filament_retraction_speed: [String(page.retractionSpeedMmS)],
  fan_min_speed: [String(page.coolingFanMinPct)],
  fan_max_speed: [String(page.coolingFanMaxPct)],
  CompatiblePrinters: [printer.name],
};
---

<BaseLayout title={pageTitle} description={pageDescription} jsonLd={faqSchema}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Minimal Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-neutral-500 mb-6">
      <a href={withBase('/')} class="hover:text-neutral-950">Home</a>
      <span>/</span>
      <a href={withBase(`/printer/${printer.slug}/`)} class="hover:text-neutral-950">{printer.name}</a>
      <span>/</span>
      <a href={withBase(`/filament/${filament.slug}/`)} class="hover:text-neutral-950">{filament.name}</a>
    </nav>

    <!-- 1. ABOVE-THE-FOLD SWISS SUMMARY CARD (Instant 2-Second Read) -->
    <div class="divide-y divide-neutral-200 border border-neutral-300 bg-white shadow-sm mb-8">
      <!-- Header & Download Preset Bar -->
      <div class="p-6 sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
          <div class="flex items-center gap-2">
            <span class="bg-neutral-950 text-white font-mono uppercase text-xs px-2.5 py-1 inline-flex items-center gap-2">
              <span class={`w-2 h-2 rounded-full ${page.compatibilityVerdict === 'Optimal Match' ? 'bg-emerald-400' : 'bg-amber-400'}`}></span>
              {page.compatibilityVerdict}
            </span>
            <span class="text-xs font-mono text-neutral-500 px-2 py-0.5 bg-neutral-100">
              {filament.materialType} • {printer.extruderType}
            </span>
          </div>

          <!-- 1-Click Download Preset -->
          <button
            id="download-orca-preset-btn"
            type="button"
            data-slug={page.slug}
            data-preset={JSON.stringify(orcaPresetPayload)}
            class="bg-orange-600 hover:bg-orange-500 text-white font-medium px-4 py-2.5 text-xs sm:text-sm uppercase tracking-wider font-mono cursor-pointer transition-colors"
          >
            ↓ Download OrcaSlicer .JSON Preset
          </button>
        </div>

        <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-neutral-950 mb-3">
          {printer.name} + {filament.name} Settings
        </h1>

        <p class="text-base text-neutral-600 leading-relaxed max-w-3xl">
          {page.heroSummary}
        </p>
      </div>

      <!-- 4 Big Numbers (Zero Clutter) -->
      <div class="grid grid-cols-2 sm:grid-cols-4 divide-y sm:divide-y-0 divide-x divide-neutral-200 bg-neutral-50/60">
        <div class="p-5 sm:p-6">
          <span class="block text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-1">Nozzle Temp</span>
          <div class="text-3xl sm:text-4xl font-mono tabular-nums font-bold text-neutral-950">
            {deterministicMath.recommendedNozzleTempC}°C
          </div>
          <span class="text-xs font-mono tabular-nums text-neutral-500 mt-1 block">
            {filament.minNozzleTempC}–{filament.maxNozzleTempC}°C range
          </span>
        </div>

        <div class="p-5 sm:p-6">
          <span class="block text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-1">Bed Temp</span>
          <div class="text-3xl sm:text-4xl font-mono tabular-nums font-bold text-neutral-950">
            {deterministicMath.recommendedBedTempC}°C
          </div>
          <span class="text-xs font-mono tabular-nums text-neutral-500 mt-1 block">
            {filament.minBedTempC}–{filament.maxBedTempC}°C range
          </span>
        </div>

        <div class="p-5 sm:p-6">
          <span class="block text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-1">Max Speed</span>
          <div class="text-3xl sm:text-4xl font-mono tabular-nums font-bold text-emerald-600">
            {deterministicMath.calculatedMaxPrintSpeedMmS} <span class="text-base font-normal text-neutral-500">mm/s</span>
          </div>
          <span class="text-xs font-mono tabular-nums text-neutral-500 mt-1 block">
            {deterministicMath.effectiveVolumetricFlowMm3s} mm³/s flow limit
          </span>
        </div>

        <div class="p-5 sm:p-6">
          <span class="block text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-1">Retraction</span>
          <div class="text-3xl sm:text-4xl font-mono tabular-nums font-bold text-neutral-950">
            {page.retractionDistanceMm} <span class="text-base font-normal text-neutral-500">mm</span>
          </div>
          <span class="text-xs font-mono tabular-nums text-neutral-500 mt-1 block">
            @ {page.retractionSpeedMmS} mm/s • Fan {page.coolingFanMaxPct}%
          </span>
        </div>
      </div>
    </div>

    <!-- 2. URGENT HARDWARE & CONSUMABLE CALLOUTS -->
    <div class="space-y-4 mb-8">
      <!-- Abrasive Nozzle Blocker -->
      {isAbrasiveOrComposite && (
        <div class="border-2 border-amber-600 bg-amber-50/50 p-4 sm:p-5 text-amber-950 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <div class="font-bold text-sm sm:text-base mb-1">
              ⚠️ Brass Nozzle Wear Warning: {filament.name} is abrasive and will destroy the stock nozzle on your {printer.name}. Upgrade to a 0.4mm/0.6mm Hardened Steel Nozzle before printing.
            </div>
            <p class="text-xs text-amber-800">
              Stock nozzle on {printer.name}: <strong>{printer.defaultNozzleMaterial}</strong>.
            </p>
          </div>
          <a
            href={hardenedNozzleAmazonUrl}
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="shrink-0 bg-neutral-950 hover:bg-neutral-800 text-white font-medium px-4 py-2 text-sm uppercase tracking-wider"
          >
            Get Hardened Nozzle ↗
          </a>
        </div>
      )}

      <!-- Primary Spool + Optional Dryer Bar -->
      <div class="border border-neutral-300 bg-white p-4 sm:p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-mono uppercase text-neutral-400 block">Recommended Consumables</span>
          <span class="font-bold text-neutral-950 text-base">{filament.name} (1.75mm, 1kg)</span>
          <span class="text-xs text-neutral-500 block mt-0.5">Bed surface: {page.bedSurfaceRecommendation}</span>
        </div>

        <div class="flex flex-wrap gap-2.5 w-full sm:w-auto">
          <a
            href={primaryFilamentAmazonUrl}
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="bg-neutral-950 hover:bg-neutral-800 text-white font-medium px-4 py-2 text-sm uppercase tracking-wider"
          >
            Buy {filament.name} (1kg Spool) on Amazon ↗
          </a>
          {deterministicMath.requiresFilamentDryer && (
            <a
              href={filamentDryerAmazonUrl}
              target="_blank"
              rel="noopener noreferrer sponsored"
              class="border border-neutral-300 hover:border-neutral-950 bg-neutral-50 text-neutral-900 font-medium px-3.5 py-2 text-xs uppercase tracking-wider"
            >
              Filament Dryer ($39) ↗
            </a>
          )}
          {deterministicMath.requiresFilamentDryer && (
            <a
              href={buildPlateGlueAmazonUrl}
              target="_blank"
              rel="noopener noreferrer sponsored"
              class="border border-neutral-300 hover:border-neutral-950 bg-neutral-50 text-neutral-900 font-medium px-3.5 py-2 text-xs uppercase tracking-wider"
            >
              PEI Plate / Glue ($16) ↗
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- 3. INTERACTIVE NOZZLE & LAYER SPEED CALCULATOR -->
    <section
      id="speed-calculator"
      data-flow={deterministicMath.effectiveVolumetricFlowMm3s}
      data-abrasive={String(isAbrasiveOrComposite)}
      data-filament-name={filament.name}
      class="border border-neutral-300 bg-white divide-y divide-neutral-200 mb-8"
    >
      <div class="px-6 py-4 bg-neutral-50 flex items-center justify-between">
        <h2 class="text-base font-bold text-neutral-950">Interactive Speed Calculator</h2>
        <span class="text-xs font-mono tabular-nums text-neutral-500">
          Max Flow: {deterministicMath.effectiveVolumetricFlowMm3s} mm³/s
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 divide-y md:divide-y-0 md:divide-x divide-neutral-200">
        <!-- Controls -->
        <div class="md:col-span-7 p-6 space-y-6">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-neutral-500 mb-2">
              Nozzle Size
            </label>
            <div class="grid grid-cols-4 border border-neutral-300 divide-x divide-neutral-300" id="nozzle-btn-group">
              {[0.2, 0.4, 0.6, 0.8].map((size) => (
                <button
                  type="button"
                  data-nozzle={size}
                  class={`nozzle-select-btn py-2.5 px-3 font-mono tabular-nums font-bold text-sm cursor-pointer transition-colors ${
                    size === 0.4
                      ? 'bg-neutral-950 text-white'
                      : 'bg-white text-neutral-700 hover:bg-neutral-100'
                  }`}
                >
                  {size.toFixed(1)}mm
                </button>
              ))}
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between mb-2">
              <label for="layer-height-slider" class="text-xs font-semibold uppercase tracking-wider text-neutral-500">
                Layer Height
              </label>
              <span id="layer-height-display" class="font-mono tabular-nums font-bold text-sm text-orange-600">
                0.20 mm
              </span>
            </div>
            <input
              id="layer-height-slider"
              type="range"
              min="0.08"
              max="0.40"
              step="0.02"
              value="0.20"
              class="w-full swiss-slider"
            />
            <div class="flex justify-between text-[11px] font-mono text-neutral-400 mt-1">
              <span>0.08mm (Fine)</span>
              <span>0.20mm (Standard)</span>
              <span>0.40mm (Draft)</span>
            </div>
          </div>
        </div>

        <!-- Output -->
        <div class="md:col-span-5 p-6 bg-neutral-50/50 flex flex-col justify-between">
          <div>
            <span class="block text-xs font-semibold uppercase tracking-wider text-neutral-400">Safe Print Speed</span>
            <div class="flex items-baseline gap-1.5 mt-1">
              <span id="calc-max-speed" class="text-5xl font-mono tabular-nums font-extrabold text-neutral-950">
                {deterministicMath.calculatedMaxPrintSpeedMmS}
              </span>
              <span class="text-sm font-mono text-neutral-500">mm/s</span>
            </div>
            <p id="calc-line-width-note" class="text-xs font-mono tabular-nums text-neutral-500 mt-1">
              Line width: 0.42 mm
            </p>
          </div>

          <div class="grid grid-cols-2 gap-4 pt-4 mt-4 border-t border-neutral-200">
            <div>
              <span class="block text-[11px] uppercase text-neutral-400">100g Print Time</span>
              <span id="calc-print-time" class="text-lg font-mono tabular-nums font-bold text-neutral-950">
                1h 36m
              </span>
            </div>
            <div>
              <span class="block text-[11px] uppercase text-neutral-400">Clog Risk</span>
              <span id="calc-clog-risk" class="text-sm font-mono font-bold text-emerald-600 block mt-0.5">
                Low Risk
              </span>
            </div>
          </div>

          <div
            id="calc-clog-warning-banner"
            class="hidden mt-3 border border-red-500 bg-red-50 p-3 text-xs text-red-900"
          >
            ⚠️ <strong>Clog Warning:</strong> Do not use a 0.2mm nozzle with {filament.name} (&lt;0.4mm orifices jam with composite fibers).
          </div>
        </div>
      </div>
    </section>

    <!-- 4. TOP ORCASLICER TIPS (Clean 2x2 Grid) -->
    <section class="border border-neutral-300 bg-white divide-y divide-neutral-200 mb-8">
      <div class="px-6 py-4 bg-neutral-50">
        <h2 class="text-base font-bold text-neutral-950">Key OrcaSlicer Settings to Change</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-neutral-200">
        {page.slicerTweaks.map((tweak, index) => (
          <div class="p-5 flex items-start gap-3.5 border-b border-neutral-200">
            <span class="bg-neutral-950 text-white font-mono tabular-nums text-xs px-2 py-0.5 shrink-0 mt-0.5">
              {index + 1}
            </span>
            <p class="text-sm text-neutral-700 leading-relaxed">{tweak}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. COLLAPSIBLE TROUBLESHOOTING & FAQ (Keeps Page Clean & Short, Preserves 100% SEO) -->
    <div class="space-y-4 mb-10">
      <details class="group border border-neutral-300 bg-white">
        <summary class="px-6 py-4 cursor-pointer flex items-center justify-between font-bold text-base text-neutral-950 hover:bg-neutral-50 list-none">
          <span>Troubleshooting Common Issues (Stringing, Warping &amp; Clogs)</span>
          <span class="font-mono text-sm text-neutral-400 group-open:rotate-45 transition-transform">+</span>
        </summary>
        <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-neutral-200 border-t border-neutral-200">
          {page.troubleshootingMatrix.map((item) => (
            <div class="p-5">
              <h3 class="font-bold text-sm text-neutral-950 mb-1.5">{item.issue}</h3>
              <p class="text-xs text-neutral-500 mb-3">{item.rootCause}</p>
              <div class="text-xs text-neutral-900 bg-neutral-50 p-3 border border-neutral-200">
                <strong class="text-emerald-700 block mb-0.5">Fix:</strong> {item.exactFix}
              </div>
            </div>
          ))}
        </div>
      </details>

      <details class="group border border-neutral-300 bg-white">
        <summary class="px-6 py-4 cursor-pointer flex items-center justify-between font-bold text-base text-neutral-950 hover:bg-neutral-50 list-none">
          <span>Frequently Asked Questions ({page.faq.length})</span>
          <span class="font-mono text-sm text-neutral-400 group-open:rotate-45 transition-transform">+</span>
        </summary>
        <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-neutral-200 border-t border-neutral-200">
          {page.faq.map((item) => (
            <div class="p-5 border-b border-neutral-200">
              <h3 class="font-bold text-sm text-neutral-950 mb-1.5">{item.question}</h3>
              <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed">{item.answer}</p>
            </div>
          ))}
        </div>
      </details>
    </div>

    <!-- 6. RELATED PROFILES -->
    <section class="border border-neutral-300 bg-white divide-y divide-neutral-200">
      <div class="px-6 py-4 bg-neutral-50 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-sm font-bold uppercase tracking-wider text-neutral-500">Related Profiles</h2>
        <div class="flex gap-4 text-xs font-semibold">
          <a href={withBase(`/printer/${printer.slug}/`)} class="text-neutral-900 hover:text-orange-600">
            All {printer.name} Filaments →
          </a>
          <a href={withBase(`/filament/${filament.slug}/`)} class="text-neutral-900 hover:text-orange-600">
            All {filament.name} Printers →
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-neutral-200">
        {neighbors.map((neighbor) => {
          const href = neighbor.isGenerated
            ? withBase(`/${neighbor.slug}/`)
            : withBase(`/printer/${neighbor.printer.slug}/#${neighbor.slug}`);
          return (
            <a href={href} class="p-4 hover:bg-neutral-50 transition-colors flex items-center justify-between border-b border-neutral-200">
              <div>
                <div class="text-xs text-neutral-400">{neighbor.printer.name}</div>
                <div class="font-bold text-sm text-neutral-950">{neighbor.filament.name}</div>
              </div>
              <div class="text-right font-mono tabular-nums text-xs">
                <span class="font-bold text-neutral-950 block">{neighbor.deterministicMath.recommendedNozzleTempC}°C</span>
                <span class="text-emerald-600">{neighbor.deterministicMath.calculatedMaxPrintSpeedMmS} mm/s</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </div>

  <script>
    function initSlicerPageInteractions() {
      const downloadBtn = document.getElementById('download-orca-preset-btn');
      if (downloadBtn) {
        downloadBtn.addEventListener('click', () => {
          const slug = downloadBtn.getAttribute('data-slug') || 'preset';
          const rawPreset = downloadBtn.getAttribute('data-preset') || '{}';
          try {
            const parsed = JSON.parse(rawPreset);
            const prettyJson = JSON.stringify(parsed, null, 2);
            const blob = new Blob([prettyJson], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `${slug}-orcaslicer.json`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
          } catch (e) {
            console.error('Failed to build OrcaSlicer preset download', e);
          }
        });
      }

      const calcSection = document.getElementById('speed-calculator');
      if (!calcSection) return;

      const effectiveFlow = parseFloat(calcSection.getAttribute('data-flow') || '14');
      const isAbrasive = calcSection.getAttribute('data-abrasive') === 'true';

      let currentNozzle = 0.4;
      const slider = document.getElementById('layer-height-slider') as HTMLInputElement | null;
      const layerDisplay = document.getElementById('layer-height-display');
      const speedDisplay = document.getElementById('calc-max-speed');
      const lineWidthNote = document.getElementById('calc-line-width-note');
      const printTimeDisplay = document.getElementById('calc-print-time');
      const clogRiskEl = document.getElementById('calc-clog-risk');
      const clogBanner = document.getElementById('calc-clog-warning-banner');
      const nozzleButtons = document.querySelectorAll('.nozzle-select-btn');

      function recalculate() {
        const layerHeight = slider ? parseFloat(slider.value) : 0.2;
        if (layerDisplay) {
          layerDisplay.textContent = `${layerHeight.toFixed(2)} mm`;
        }

        const lineWidth = currentNozzle * 1.05;
        const safeMaxSpeed = Math.round(effectiveFlow / (layerHeight * lineWidth));

        if (speedDisplay) {
          speedDisplay.textContent = String(safeMaxSpeed);
        }
        if (lineWidthNote) {
          lineWidthNote.textContent = `Line width: ${lineWidth.toFixed(2)} mm @ ${layerHeight.toFixed(2)} mm layer`;
        }

        const actualAvgFlow = effectiveFlow * 0.65;
        const totalSeconds = Math.round(80645 / Math.max(1, actualAvgFlow));
        const hours = Math.floor(totalSeconds / 3600);
        const mins = Math.round((totalSeconds % 3600) / 60);
        if (printTimeDisplay) {
          printTimeDisplay.textContent = hours > 0 ? `${hours}h ${mins}m` : `${mins}m`;
        }

        if (clogRiskEl && clogBanner) {
          if (currentNozzle <= 0.2 && isAbrasive) {
            clogRiskEl.textContent = 'High Clog Risk';
            clogRiskEl.className = 'text-sm font-mono font-bold text-red-600 block mt-0.5';
            clogBanner.classList.remove('hidden');
          } else if (currentNozzle === 0.4 && isAbrasive) {
            clogRiskEl.textContent = 'Hardened Req';
            clogRiskEl.className = 'text-sm font-mono font-bold text-amber-600 block mt-0.5';
            clogBanner.classList.add('hidden');
          } else {
            clogRiskEl.textContent = 'Low Risk';
            clogRiskEl.className = 'text-sm font-mono font-bold text-emerald-600 block mt-0.5';
            clogBanner.classList.add('hidden');
          }
        }
      }

      nozzleButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          currentNozzle = parseFloat(btn.getAttribute('data-nozzle') || '0.4');
          nozzleButtons.forEach((b) => {
            b.className =
              'nozzle-select-btn py-2.5 px-3 font-mono tabular-nums font-bold text-sm cursor-pointer transition-colors bg-white text-neutral-700 hover:bg-neutral-100';
          });
          btn.className =
            'nozzle-select-btn py-2.5 px-3 font-mono tabular-nums font-bold text-sm cursor-pointer transition-colors bg-neutral-950 text-white';
          recalculate();
        });
      });

      if (slider) {
        slider.addEventListener('input', recalculate);
      }

      recalculate();
    }

    initSlicerPageInteractions();
  </script>
</BaseLayout>
