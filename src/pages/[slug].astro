      </div>

      <!-- Detailed Parameter Summary Card -->
      <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
        <h3 class="text-lg font-bold text-white mb-4 font-mono">
          Complete Slicer Cheat Sheet
        </h3>
        <dl class="divide-y divide-slate-800/80 text-sm">
          <div class="py-2.5 flex justify-between gap-2">
            <dt class="text-slate-400">First Layer Speed</dt>
            <dd class="font-mono font-semibold text-white">{page.firstLayerSpeedMmS} mm/s</dd>
          </div>
          <div class="py-2.5 flex justify-between gap-2">
            <dt class="text-slate-400">Nozzle Temp</dt>
            <dd class="font-mono font-semibold text-orange-400">{deterministicMath.recommendedNozzleTempC}°C</dd>
          </div>
          <div class="py-2.5 flex justify-between gap-2">
            <dt class="text-slate-400">Bed Temp</dt>
            <dd class="font-mono font-semibold text-amber-300">{deterministicMath.recommendedBedTempC}°C</dd>
          </div>
          <div class="py-2.5 flex justify-between gap-2">
            <dt class="text-slate-400">Cooling Fan Range</dt>
            <dd class="font-mono font-semibold text-white">{page.coolingFanMinPct}% – {page.coolingFanMaxPct}%</dd>
          </div>
          <div class="py-2.5 flex justify-between gap-2">
            <dt class="text-slate-400">Retraction Length</dt>
            <dd class="font-mono font-semibold text-white">{page.retractionDistanceMm} mm</dd>
          </div>
          <div class="py-2.5 flex justify-between gap-2">
            <dt class="text-slate-400">Retraction Speed</dt>
            <dd class="font-mono font-semibold text-white">{page.retractionSpeedMmS} mm/s</dd>
          </div>
          <div class="py-2.5 flex justify-between gap-2">
            <dt class="text-slate-400">Volumetric Limit</dt>
            <dd class="font-mono font-semibold text-emerald-400">{deterministicMath.effectiveVolumetricFlowMm3s} mm³/s</dd>
          </div>
          <div class="py-2.5 flex flex-col gap-1">
            <dt class="text-slate-400">Build Surface</dt>
            <dd class="font-mono text-xs text-slate-200 bg-slate-950 p-2 rounded border border-slate-800">
              {page.bedSurfaceRecommendation}
            </dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- 5. TROUBLESHOOTING MATRIX -->
    <section class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 sm:p-8 mb-12">
      <div class="mb-6">
        <span class="text-xs font-mono uppercase tracking-wider text-orange-400">Failure Mode Diagnostics</span>
        <h2 class="text-xl sm:text-2xl font-bold text-white">
          {printer.name} × {filament.name} Troubleshooting Matrix
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {page.troubleshootingMatrix.map((item) => (
          <div class="rounded-xl bg-slate-950/90 border border-slate-800 p-5 flex flex-col justify-between">
            <div>
              <div class="inline-flex items-center gap-1.5 text-xs font-mono text-rose-400 mb-2">
                <span>SYMPTOM / ISSUE</span>
              </div>
              <h3 class="font-bold text-white text-base mb-3">{item.issue}</h3>
              <p class="text-xs text-slate-400 mb-4 leading-relaxed">
                <strong class="text-slate-300">Root Cause:</strong> {item.rootCause}
              </p>
            </div>
            <div class="pt-3 border-t border-slate-800/80">
              <span class="block text-[11px] font-mono uppercase text-emerald-400 mb-1">Exact Slicer / Hardware Fix</span>
              <p class="text-xs sm:text-sm text-slate-200 leading-relaxed">{item.exactFix}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 6. FREQUENTLY ASKED QUESTIONS (Matching JSON-LD Schema) -->
    <section class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 sm:p-8 mb-12">
      <span class="text-xs font-mono uppercase tracking-wider text-orange-400">Engineering Q&A</span>
      <h2 class="text-xl sm:text-2xl font-bold text-white mb-6">
        Frequently Asked Questions
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {page.faq.map((item) => (
          <div class="rounded-xl bg-slate-950/80 border border-slate-800 p-5">
            <h3 class="font-bold text-white text-base mb-2">{item.question}</h3>
            <p class="text-sm text-slate-300 leading-relaxed">{item.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 7. SEO & INTERNAL LINK MESH -->
    <section aria-label="Internal Link Mesh" class="rounded-2xl border border-slate-800 bg-slate-900/40 p-6 sm:p-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-6 border-b border-slate-800">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-orange-400">Category Hubs & Related Profiles</span>
          <h2 class="text-xl font-bold text-white mt-0.5">Explore Connected Slicer Profiles</h2>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href={`/printer/${printer.slug}/`}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-mono border border-slate-700 transition-colors"
          >
            <span>All {printer.name} Profiles →</span>
          </a>
          <a
            href={`/filament/${filament.slug}/`}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-mono border border-slate-700 transition-colors"
          >
            <span>All {filament.name} Printers →</span>
          </a>
        </div>
      </div>

      <h3 class="text-xs font-mono uppercase tracking-wider text-slate-400 mb-4">
        6 Neighboring Printer × Filament Combinations
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {neighbors.map((neighbor) => {
          const href = neighbor.isGenerated
            ? `/${neighbor.slug}/`
            : `/printer/${neighbor.printer.slug}/#${neighbor.slug}`;
          return (
            <a
              href={href}
              class="group rounded-xl bg-slate-950/80 border border-slate-800/90 hover:border-orange-500/50 p-4 transition-all flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between gap-2 text-[11px] font-mono text-slate-400 mb-1">
                  <span>{neighbor.printer.name}</span>
                  <span class="text-emerald-400">{neighbor.deterministicMath.effectiveVolumetricFlowMm3s} mm³/s</span>
                </div>
                <div class="font-bold text-sm text-white group-hover:text-orange-400 transition-colors">
                  {neighbor.printer.name} × {neighbor.filament.name}
                </div>
              </div>
              <div class="mt-3 pt-2 border-t border-slate-900 flex items-center justify-between text-xs font-mono text-slate-400">
                <span>{neighbor.deterministicMath.recommendedNozzleTempC}°C / {neighbor.deterministicMath.recommendedBedTempC}°C</span>
                <span class="text-orange-400">{neighbor.deterministicMath.calculatedMaxPrintSpeedMmS} mm/s →</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </div>

  <!-- Client-Side Interactive Calculator & OrcaSlicer JSON Preset Generator -->
  <script>
    function initSlicerPageInteractions() {
      // 1. One-Click Download .json OrcaSlicer Filament Preset
      const downloadBtn = document.getElementById('download-orca-preset-btn');
      if (downloadBtn) {
        downloadBtn.addEventListener('click', () => {
          const slug = downloadBtn.getAttribute('data-slug') || 'preset';
          const rawPreset = downloadBtn.getAttribute('data-preset') || '{}';
          try {
            const parsed = JSON.parse(rawPreset);
            const prettyJson = JSON.stringify(parsed, null, 2);
            const blob = new Blob([prettyJson], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `${slug}-orcaslicer.json`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
          } catch (e) {
            console.error('Failed to build OrcaSlicer preset download', e);
          }
        });
      }

      // 2. Interactive Nozzle & Layer Speed Calculator
      const calcSection = document.getElementById('speed-calculator');
      if (!calcSection) return;

      const effectiveFlow = parseFloat(calcSection.getAttribute('data-flow') || '14');
      const isAbrasive = calcSection.getAttribute('data-abrasive') === 'true';

      let currentNozzle = 0.4;
      const slider = document.getElementById('layer-height-slider') as HTMLInputElement | null;
      const layerDisplay = document.getElementById('layer-height-display');
      const speedDisplay = document.getElementById('calc-max-speed');
      const lineWidthNote = document.getElementById('calc-line-width-note');
      const printTimeDisplay = document.getElementById('calc-print-time');
      const clogRiskEl = document.getElementById('calc-clog-risk');
      const clogSubEl = document.getElementById('calc-clog-sub');
      const clogBanner = document.getElementById('calc-clog-warning-banner');
      const nozzleButtons = document.querySelectorAll('.nozzle-select-btn');

      function recalculate() {
        const layerHeight = slider ? parseFloat(slider.value) : 0.2;
        if (layerDisplay) {
          layerDisplay.textContent = `${layerHeight.toFixed(2)} mm`;
        }

        const lineWidth = currentNozzle * 1.05;
        const safeMaxSpeed = Math.round(effectiveFlow / (layerHeight * lineWidth));

        if (speedDisplay) {
          speedDisplay.textContent = String(safeMaxSpeed);
        }
        if (lineWidthNote) {
          lineWidthNote.textContent = `Line Width (105%): ${lineWidth.toFixed(2)} mm @ ${layerHeight.toFixed(2)} mm layer`;
        }

        // Estimate 100g print time (~80,645 mm³ volume at 1.24g/cm³, accounting for 65% effective duty cycle)
        const actualAvgFlow = effectiveFlow * 0.65;
        const totalSeconds = Math.round(80645 / Math.max(1, actualAvgFlow));
        const hours = Math.floor(totalSeconds / 3600);
        const mins = Math.round((totalSeconds % 3600) / 60);
        if (printTimeDisplay) {
          printTimeDisplay.textContent = hours > 0 ? `${hours}h ${mins}m` : `${mins}m`;
        }

        // Clog Risk evaluation
        if (clogRiskEl && clogSubEl && clogBanner) {
          if (currentNozzle <= 0.2 && isAbrasive) {
            clogRiskEl.textContent = 'CRITICAL CLOG RISK';
            clogRiskEl.className = 'text-sm font-mono font-bold text-red-400 mt-1.5';
            clogSubEl.textContent = '0.2mm + abrasive fibres jam!';
            clogBanner.classList.remove('hidden');
          } else if (currentNozzle === 0.4 && isAbrasive) {
            clogRiskEl.textContent = 'MODERATE RISK';
            clogRiskEl.className = 'text-sm font-mono font-bold text-amber-400 mt-1.5';
            clogSubEl.textContent = 'Use Hardened 0.4mm / 0.6mm';
            clogBanner.classList.add('hidden');
          } else if (layerHeight > currentNozzle * 0.75) {
            clogRiskEl.textContent = 'EXTRUSION LIMIT';
            clogRiskEl.className = 'text-sm font-mono font-bold text-amber-400 mt-1.5';
            clogSubEl.textContent = 'Layer exceeds 75% nozzle Ø';
            clogBanner.classList.add('hidden');
          } else {
            clogRiskEl.textContent = 'LOW RISK';
            clogRiskEl.className = 'text-sm font-mono font-bold text-emerald-400 mt-1.5';
            clogSubEl.textContent = 'Optimal melt zone geometry';
            clogBanner.classList.add('hidden');
          }
        }
      }

      nozzleButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const size = parseFloat(btn.getAttribute('data-nozzle') || '0.4');
          currentNozzle = size;

          nozzleButtons.forEach((b) => {
            b.className =
              'nozzle-select-btn py-3 px-4 rounded-xl font-mono font-bold text-sm border transition-all cursor-pointer bg-slate-950 text-slate-300 border-slate-800 hover:border-slate-700';
          });
          btn.className =
            'nozzle-select-btn py-3 px-4 rounded-xl font-mono font-bold text-sm border transition-all cursor-pointer bg-orange-500 text-slate-950 border-orange-400 shadow-lg shadow-orange-500/20';

          recalculate();
        });
      });

      if (slider) {
        slider.addEventListener('input', recalculate);
      }

      recalculate();
    }

    initSlicerPageInteractions();
  </script>
</BaseLayout>
