---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PUBLIC_AMAZON_AFFILIATE_TAG } from '../config';
import {
  loadGeneratedPages,
  loadAllSeeds,
  type PageProfileData,
} from '../utils/data';

export function getStaticPaths() {
  const pages = loadGeneratedPages();
  const allSeeds = loadAllSeeds();
  const generatedMap = new Map(pages.map((p) => [p.slug, p]));

  return pages.map((page) => {
    const otherGenerated = pages.filter((p) => p.slug !== page.slug);
    const samePrinterSeeds = allSeeds
      .filter((s) => s.printer.slug === page.printer.slug && s.slug !== page.slug)
      .slice(0, 4);
    const sameFilamentSeeds = allSeeds
      .filter((s) => s.filament.slug === page.filament.slug && s.slug !== page.slug)
      .slice(0, 4);

    const neighborsMap = new Map();
    for (const item of [...otherGenerated, ...samePrinterSeeds, ...sameFilamentSeeds]) {
      if (!neighborsMap.has(item.slug) && neighborsMap.size < 6) {
        neighborsMap.set(item.slug, {
          ...item,
          isGenerated: generatedMap.has(item.slug),
        });
      }
    }

    return {
      params: { slug: page.slug },
      props: {
        page,
        neighbors: Array.from(neighborsMap.values()),
      },
    };
  });
}

interface Props {
  page: PageProfileData;
  neighbors: Array<PageProfileData & { isGenerated?: boolean }>;
}

const { page, neighbors } = Astro.props;
const { printer, filament, deterministicMath } = page;
const AFFILIATE_TAG = PUBLIC_AMAZON_AFFILIATE_TAG;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p: string) => `${BASE}${p.startsWith('/') ? p : '/' + p}`;

// Parametric Amazon URLs
const primaryFilamentAmazonUrl = `https://www.amazon.com/s?k=${encodeURIComponent(
  filament.name + ' 1.75mm 1kg filament'
)}&tag=${AFFILIATE_TAG}`;

const hardenedNozzleAmazonUrl = `https://www.amazon.com/s?k=${encodeURIComponent(
  printer.name + ' hardened steel nozzle 0.4mm 0.6mm'
)}&tag=${AFFILIATE_TAG}`;

const filamentDryerAmazonUrl = `https://www.amazon.com/s?k=${encodeURIComponent(
  '3D filament dryer box 70C Creality Space Pi Sunlu S2'
)}&tag=${AFFILIATE_TAG}`;

const buildPlateGlueAmazonUrl = `https://www.amazon.com/s?k=${encodeURIComponent(
  printer.name + ' textured PEI build plate liquid glue'
)}&tag=${AFFILIATE_TAG}`;

const isAbrasiveOrComposite =
  deterministicMath.requiresHardenedNozzleUpgrade ||
  filament.isAbrasive ||
  /cf|gf|glow|wood|carbon|glass/i.test(filament.name) ||
  /cf|gf|glow|wood/i.test(filament.materialType);

const verdictSignalColor =
  page.compatibilityVerdict === 'Optimal Match'
    ? 'text-emerald-400'
    : page.compatibilityVerdict === 'Requires Upgrade'
    ? 'text-amber-400'
    : 'text-red-400';

const pageTitle = `Best ${printer.name} Settings for ${filament.name} (OrcaSlicer Profile)`;
const pageDescription = page.heroSummary;

// FAQPage JSON-LD Schema
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

// Pre-build OrcaSlicer preset JSON payload for client download
const orcaPresetPayload = {
  type: 'filament',
  name: `${filament.name} @${printer.name} (SlicerMatrix)`,
  inherits: `Generic ${filament.materialType}`,
  from: 'User',
  instantiation: 'true',
  filament_id: page.slug.slice(0, 16),
  filament_type: [filament.materialType],
  filament_vendor: [filament.brand],
  nozzle_temperature: [String(deterministicMath.recommendedNozzleTempC)],
  nozzle_temperature_initial_layer: [
    String(Math.min(printer.maxNozzleTempC, deterministicMath.recommendedNozzleTempC + 5)),
  ],
  nozzle_temperature_range_low: [String(filament.minNozzleTempC)],
  nozzle_temperature_range_high: [String(filament.maxNozzleTempC)],
  hot_plate_temp: [String(deterministicMath.recommendedBedTempC)],
  hot_plate_temp_initial_layer: [String(deterministicMath.recommendedBedTempC)],
  textured_plate_temp: [String(deterministicMath.recommendedBedTempC)],
  textured_plate_temp_initial_layer: [String(deterministicMath.recommendedBedTempC)],
  filament_max_volumetric_speed: [String(deterministicMath.effectiveVolumetricFlowMm3s)],
  filament_retraction_length: [String(page.retractionDistanceMm)],
  filament_retraction_speed: [String(page.retractionSpeedMmS)],
  fan_min_speed: [String(page.coolingFanMinPct)],
  fan_max_speed: [String(page.coolingFanMaxPct)],
  CompatiblePrinters: [printer.name],
};
---

<BaseLayout title={pageTitle} description={pageDescription} jsonLd={faqSchema}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Swiss Specification Breadcrumb Strip -->
    <nav
      aria-label="Breadcrumb"
      class="border border-b-0 border-neutral-300 bg-neutral-100 px-4 py-2.5 flex flex-wrap items-center justify-between gap-2 text-[11px] font-mono uppercase tracking-wider text-neutral-600"
    >
      <div class="flex flex-wrap items-center gap-2">
        <a href={withBase('/')} class="hover:text-orange-600 font-bold text-neutral-950">INDEX</a>
        <span>/</span>
        <a href={withBase(`/printer/${printer.slug}/`)} class="hover:text-orange-600">{printer.name}</a>
        <span>/</span>
        <a href={withBase(`/filament/${filament.slug}/`)} class="hover:text-orange-600">{filament.name}</a>
        <span>/</span>
        <span class="text-neutral-950 font-semibold">CALIBRATION SHEET</span>
      </div>
      <div class="font-mono tabular-nums text-[11px] text-neutral-500">
        REF // {page.slug.toUpperCase().slice(0, 32)}
      </div>
    </nav>

    <!-- SINGLE COHESIVE SWISS SPECIFICATION CANVAS -->
    <div class="divide-y divide-neutral-200 border border-neutral-300 bg-white">
      <!-- 01. ABOVE-THE-FOLD VERDICT & PRIMARY METRICS MATRIX -->
      <section class="divide-y divide-neutral-200">
        <!-- Top Status & Action Bar -->
        <div class="p-6 sm:p-8 flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-neutral-50">
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="bg-neutral-950 text-white font-mono uppercase text-xs px-2.5 py-1 inline-flex items-center gap-2">
              <span class={`inline-block w-2 h-2 ${verdictSignalColor === 'text-emerald-400' ? 'bg-emerald-400' : verdictSignalColor === 'text-amber-400' ? 'bg-amber-400' : 'bg-red-500'}`}></span>
              <span>VERDICT: <strong class={verdictSignalColor}>{page.compatibilityVerdict}</strong></span>
            </span>
            <span class="border border-neutral-300 bg-white text-neutral-900 font-mono uppercase text-xs px-2.5 py-1">
              {printer.extruderType}
            </span>
            <span class="border border-neutral-300 bg-white text-neutral-900 font-mono uppercase text-xs px-2.5 py-1">
              {printer.enclosed ? 'ENCLOSED CHAMBER' : 'OPEN FRAME'}
            </span>
            <span class="border border-neutral-300 bg-white text-neutral-900 font-mono uppercase text-xs px-2.5 py-1">
              POLYMER: {filament.materialType}
            </span>
          </div>

          <!-- One-Click Download .json OrcaSlicer Filament Preset -->
          <button
            id="download-orca-preset-btn"
            type="button"
            data-slug={page.slug}
            data-preset={JSON.stringify(orcaPresetPayload)}
            class="bg-neutral-950 hover:bg-neutral-800 text-white font-medium px-4 py-2 text-sm uppercase tracking-wider font-mono inline-flex items-center justify-center gap-2 cursor-pointer transition-none shrink-0"
          >
            <span>↓ DOWNLOAD .JSON ORCASLICER FILAMENT PRESET</span>
          </button>
        </div>

        <!-- Asymmetric Title & Engineering Summary -->
        <div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-neutral-200">
          <div class="lg:col-span-8 p-6 sm:p-10">
            <div class="text-xs font-mono uppercase tracking-widest text-neutral-500 mb-2">
              01 // PRIMARY CALIBRATION SPECIFICATION
            </div>
            <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-neutral-950 leading-[1.03] uppercase mb-5">
              Best {printer.name} Settings for {filament.name} (OrcaSlicer Profile)
            </h1>
            <p class="text-base sm:text-lg text-neutral-800 leading-relaxed max-w-3xl">
              {page.heroSummary}
            </p>
          </div>

          <div class="lg:col-span-4 p-6 sm:p-8 bg-neutral-50 flex flex-col justify-between">
            <div>
              <div class="text-[11px] font-mono uppercase tracking-widest text-neutral-500 mb-2">
                HARDWARE CONFIGURATION BASELINE
              </div>
              <dl class="divide-y divide-neutral-200 border-y border-neutral-200 text-xs font-mono tabular-nums">
                <div class="py-2 flex justify-between">
                  <dt class="text-neutral-500">STOCK NOZZLE</dt>
                  <dd class="font-bold text-neutral-950 uppercase">{printer.defaultNozzleMaterial}</dd>
                </div>
                <div class="py-2 flex justify-between">
                  <dt class="text-neutral-500">HOTEND CEILING</dt>
                  <dd class="font-bold text-neutral-950">{printer.maxNozzleTempC}°C</dd>
                </div>
                <div class="py-2 flex justify-between">
                  <dt class="text-neutral-500">BED CEILING</dt>
                  <dd class="font-bold text-neutral-950">{printer.maxBedTempC}°C</dd>
                </div>
                <div class="py-2 flex justify-between">
                  <dt class="text-neutral-500">BUILD PLATE PREP</dt>
                  <dd class="font-bold text-neutral-950 text-right max-w-[180px] truncate" title={page.bedSurfaceRecommendation}>
                    {page.bedSurfaceRecommendation}
                  </dd>
                </div>
              </dl>
            </div>
            <div class="pt-4 text-[11px] font-mono uppercase text-emerald-700 font-bold">
              ● DETERMINISTIC VOLUMETRIC VERIFIED
            </div>
          </div>
        </div>

        <!-- 4-Column Quick Spec Telemetry Matrix -->
        <div class="grid grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 divide-x divide-neutral-200 bg-white">
          <div class="p-6 sm:p-8">
            <div class="flex items-center justify-between text-[11px] font-mono uppercase tracking-widest text-neutral-500 mb-2">
              <span>01.1 // NOZZLE TEMP</span>
              <span class="text-orange-600 font-bold">THERMAL</span>
            </div>
            <div class="text-4xl sm:text-5xl font-mono tabular-nums font-bold text-neutral-950">
              {deterministicMath.recommendedNozzleTempC}°C
            </div>
            <div class="text-xs font-mono tabular-nums text-neutral-500 mt-2">
              RANGE: {filament.minNozzleTempC}–{filament.maxNozzleTempC}°C (MAX {printer.maxNozzleTempC}°C)
            </div>
          </div>

          <div class="p-6 sm:p-8">
            <div class="flex items-center justify-between text-[11px] font-mono uppercase tracking-widest text-neutral-500 mb-2">
              <span>01.2 // BED TEMP</span>
              <span class="text-neutral-900 font-bold">PLATE</span>
            </div>
            <div class="text-4xl sm:text-5xl font-mono tabular-nums font-bold text-neutral-950">
              {deterministicMath.recommendedBedTempC}°C
            </div>
            <div class="text-xs font-mono tabular-nums text-neutral-500 mt-2">
              RANGE: {filament.minBedTempC}–{filament.maxBedTempC}°C
            </div>
          </div>

          <div class="p-6 sm:p-8">
            <div class="flex items-center justify-between text-[11px] font-mono uppercase tracking-widest text-neutral-500 mb-2">
              <span>01.3 // VOLUMETRIC CAP</span>
              <span class="text-emerald-700 font-bold">FLOW</span>
            </div>
            <div class="text-4xl sm:text-5xl font-mono tabular-nums font-bold text-neutral-950">
              {deterministicMath.effectiveVolumetricFlowMm3s}<span class="text-lg font-normal text-neutral-500 ml-1">mm³/s</span>
            </div>
            <div class="text-xs font-mono tabular-nums text-emerald-700 font-semibold mt-2">
              MAX SPEED: {deterministicMath.calculatedMaxPrintSpeedMmS} mm/s @ 0.20MM
            </div>
          </div>

          <div class="p-6 sm:p-8">
            <div class="flex items-center justify-between text-[11px] font-mono uppercase tracking-widest text-neutral-500 mb-2">
              <span>01.4 // RETRACTION</span>
              <span class="text-neutral-900 font-bold">{printer.extruderType.toUpperCase()}</span>
            </div>
            <div class="text-4xl sm:text-5xl font-mono tabular-nums font-bold text-neutral-950">
              {page.retractionDistanceMm}<span class="text-lg font-normal text-neutral-500 ml-1">mm</span>
            </div>
            <div class="text-xs font-mono tabular-nums text-neutral-500 mt-2">
              SPEED: {page.retractionSpeedMmS} mm/s • FAN: {page.coolingFanMinPct}–{page.coolingFanMaxPct}%
            </div>
          </div>
        </div>
      </section>

      <!-- 02. INTERACTIVE KINEMATIC NOZZLE & LAYER HEIGHT SPEED CALCULATOR -->
      <section
        id="speed-calculator"
        data-flow={deterministicMath.effectiveVolumetricFlowMm3s}
        data-abrasive={String(isAbrasiveOrComposite)}
        data-filament-name={filament.name}
        class="divide-y divide-neutral-200"
      >
        <div class="p-6 sm:px-8 bg-neutral-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div class="flex items-center gap-2.5">
            <span class="bg-neutral-950 text-white font-mono uppercase text-xs px-2.5 py-1">
              02 // KINEMATIC TELEMETRY INSTRUMENT
            </span>
            <h2 class="text-lg sm:text-xl font-black uppercase tracking-tight text-neutral-950">
              Nozzle Diameter & Layer Height Speed Calculator
            </h2>
          </div>
          <span class="text-xs font-mono tabular-nums text-neutral-700 uppercase">
            FLOW CEILING CONSTANT: <strong>{deterministicMath.effectiveVolumetricFlowMm3s} MM³/S</strong>
          </span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-neutral-200">
          <!-- Mechanical Controls Column -->
          <div class="lg:col-span-7 p-6 sm:p-8 space-y-8 bg-white">
            <!-- Nozzle Diameter Mechanical Detent Toggles -->
            <div>
              <div class="flex items-center justify-between mb-3">
                <label class="text-xs font-mono uppercase tracking-wider font-bold text-neutral-950">
                  A. NOZZLE ORIFICE DIAMETER (MM)
                </label>
                <span class="text-[11px] font-mono text-neutral-500 uppercase">SELECT CALIBRATED ORIFICE</span>
              </div>
              <div class="grid grid-cols-4 border border-neutral-950 divide-x divide-neutral-950" id="nozzle-btn-group">
                {[0.2, 0.4, 0.6, 0.8].map((size) => (
                  <button
                    type="button"
                    data-nozzle={size}
                    class={`nozzle-select-btn py-3.5 px-4 font-mono tabular-nums font-bold text-sm uppercase cursor-pointer transition-none ${
                      size === 0.4
                        ? 'bg-neutral-950 text-white'
                        : 'bg-neutral-50 text-neutral-950 hover:bg-neutral-200'
                    }`}
                  >
                    {size.toFixed(1)} MM
                  </button>
                ))}
              </div>
            </div>

            <!-- Layer Height Linear Potentiometer Slider -->
            <div>
              <div class="flex items-center justify-between mb-3">
                <label for="layer-height-slider" class="text-xs font-mono uppercase tracking-wider font-bold text-neutral-950">
                  B. LAYER THICKNESS (0.08 MM — 0.40 MM)
                </label>
                <span
                  id="layer-height-display"
                  class="bg-neutral-950 text-white font-mono tabular-nums uppercase text-xs px-2.5 py-1"
                >
                  0.20 MM
                </span>
              </div>
              <input
                id="layer-height-slider"
                type="range"
                min="0.08"
                max="0.40"
                step="0.02"
                value="0.20"
                class="w-full swiss-slider"
              />
              <div class="flex justify-between text-[11px] font-mono tabular-nums text-neutral-500 mt-2 uppercase">
                <span>0.08 MM [FINE]</span>
                <span>0.20 MM [NOMINAL]</span>
                <span>0.32 MM [DRAFT]</span>
                <span>0.40 MM [MAX]</span>
              </div>
            </div>

            <!-- Mathematical Equation Readout -->
            <div class="border border-neutral-300 bg-neutral-50 p-4 font-mono tabular-nums text-xs text-neutral-700">
              <span class="block text-[10px] uppercase tracking-widest text-neutral-500 mb-1">
                GOVERNED KINEMATIC EQUATION
              </span>
              <code>
                V_max = Q_eff ({deterministicMath.effectiveVolumetricFlowMm3s} mm³/s) ÷ [ h_layer × (d_nozzle × 1.05) ]
              </code>
            </div>
          </div>

          <!-- Digital Readout Column -->
          <div class="lg:col-span-5 divide-y divide-neutral-200 bg-neutral-50 flex flex-col justify-between">
            <div class="p-6 sm:p-8 bg-white">
              <span class="block text-[11px] font-mono uppercase tracking-widest text-neutral-500 mb-1">
                CALCULATED SAFE MAX PRINT SPEED
              </span>
              <div class="flex items-baseline gap-2">
                <span
                  id="calc-max-speed"
                  class="text-5xl sm:text-6xl font-mono tabular-nums font-black text-neutral-950"
                >
                  {deterministicMath.calculatedMaxPrintSpeedMmS}
                </span>
                <span class="text-lg font-mono uppercase font-bold text-neutral-500">MM/S</span>
              </div>
              <p id="calc-line-width-note" class="text-xs font-mono tabular-nums text-neutral-600 mt-2 uppercase">
                EXTRUSION WIDTH (105%): 0.42 MM @ 0.20 MM LAYER
              </p>
            </div>

            <div class="grid grid-cols-2 divide-x divide-neutral-200">
              <div class="p-6">
                <span class="block text-[11px] font-mono uppercase tracking-widest text-neutral-500">
                  EST. 100G SPOOL TIME
                </span>
                <div
                  id="calc-print-time"
                  class="text-2xl font-mono tabular-nums font-bold text-neutral-950 mt-1"
                >
                  1h 36m
                </div>
                <span class="text-[11px] font-mono text-neutral-500 uppercase">65% DUTY CYCLE</span>
              </div>

              <div class="p-6">
                <span class="block text-[11px] font-mono uppercase tracking-widest text-neutral-500">
                  ORIFICE CLOG STATUS
                </span>
                <div
                  id="calc-clog-risk"
                  class="text-sm font-mono tabular-nums font-bold text-emerald-700 mt-2 uppercase"
                >
                  ● NOMINAL CLEARANCE
                </div>
                <span id="calc-clog-sub" class="text-[11px] font-mono text-neutral-500 block mt-0.5 uppercase">
                  UNRESTRICTED MELT ZONE
                </span>
              </div>
            </div>

            <!-- Dynamic Clog Warning Banner -->
            <div
              id="calc-clog-warning-banner"
              class="hidden border-2 border-red-600 bg-red-50 p-4 text-xs font-mono text-red-950"
            >
              <strong>⚠️ CRITICAL ORIFICE JAM HAZARD:</strong> DO NOT EXTRUDE {filament.name.toUpperCase()} THROUGH A 0.2MM NOZZLE. CARBON/GLASS/GLOW PARTICULATES BRIDGE ACROSS &lt;0.4MM ORIFICES INSTANTLY. SELECT 0.4MM OR 0.6MM HARDENED STEEL.
            </div>
          </div>
        </div>
      </section>

      <!-- 03. MANDATORY ENGINEERING HARDWARE & CONSUMABLE REQUIREMENTS (AFFILIATE BLOCKERS) -->
      <section aria-label="Mandatory Engineering Hardware & Consumable Specifications" class="divide-y divide-neutral-200">
        <div class="p-6 sm:px-8 bg-neutral-100 flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <span class="bg-neutral-950 text-white font-mono uppercase text-xs px-2.5 py-1">
              03 // MANDATORY HARDWARE & CONSUMABLE REQUIREMENTS
            </span>
            <h2 class="text-lg sm:text-xl font-black uppercase tracking-tight text-neutral-950">
              Pre-Flight Material & Toolhead Verification
            </h2>
          </div>
          <span class="hidden sm:inline-block text-xs font-mono uppercase text-neutral-600">
            VERIFIED SPOOL & TOOLING SPECS
          </span>
        </div>

        <div class="p-6 sm:p-8 space-y-6 bg-white">
          <!-- Conditional Abrasive Blocker Alert (Exact Swiss Spec: border-2 border-amber-600 bg-amber-50/50 p-4 text-amber-950) -->
          {isAbrasiveOrComposite && (
            <div class="border-2 border-amber-600 bg-amber-50/50 p-4 sm:p-6 text-amber-950">
              <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
                <div class="space-y-2 max-w-3xl">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="bg-amber-600 text-white font-mono uppercase text-xs px-2.5 py-1 font-bold">
                      MANDATORY TOOLHEAD UPGRADE // ABRASIVE POLYMER
                    </span>
                    <span class="font-mono tabular-nums text-xs uppercase font-semibold">
                      STOCK NOZZLE: {printer.defaultNozzleMaterial}
                    </span>
                  </div>
                  <h3 class="text-lg sm:text-xl font-black uppercase tracking-tight text-amber-950">
                    ⚠️ Brass Nozzle Wear Warning: {filament.name} is abrasive and will destroy the stock nozzle on your {printer.name}. Upgrade to a 0.4mm/0.6mm Hardened Steel Nozzle before printing.
                  </h3>
                  <p class="text-xs sm:text-sm text-amber-900 leading-relaxed">
                    Chopped carbon/glass fibers and glow-in-the-dark strontium aluminate particulates erode standard {printer.defaultNozzleMaterial} orifices within 250g of extrusion, causing severe dimensional drift and under-extrusion.
                  </p>
                </div>

                <a
                  href={hardenedNozzleAmazonUrl}
                  target="_blank"
                  rel="noopener noreferrer sponsored"
                  class="w-full lg:w-auto shrink-0 text-center bg-neutral-950 hover:bg-neutral-800 text-white font-medium px-4 py-2 text-sm uppercase tracking-wider font-mono transition-none"
                >
                  Required: {printer.name} Hardened Steel Nozzle (0.4/0.6mm) ↗
                </a>
              </div>
            </div>
          )}

          <!-- Conditional Moisture / Adhesion Blocker Alert -->
          {deterministicMath.requiresFilamentDryer && (
            <div class="border-2 border-amber-600 bg-amber-50/50 p-4 sm:p-6 text-amber-950">
              <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
                <div class="space-y-1.5 max-w-2xl">
                  <div class="flex items-center gap-2">
                    <span class="bg-neutral-950 text-white font-mono uppercase text-xs px-2.5 py-1">
                      HYGROSCOPIC POLYMER CONDITIONING
                    </span>
                    <span class="font-mono text-xs uppercase font-bold text-amber-900">
                      SURFACE: {page.bedSurfaceRecommendation}
                    </span>
                  </div>
                  <h3 class="text-base sm:text-lg font-black uppercase tracking-tight text-amber-950">
                    Active Thermal Desiccation Required for {filament.name} ({filament.materialType})
                  </h3>
                  <p class="text-xs sm:text-sm text-amber-900 leading-relaxed">
                    Extruding unconditioned {filament.materialType} at {deterministicMath.recommendedNozzleTempC}°C induces steam hydrolysis in the hotend melt zone, degrading tensile weld strength and surface finish.
                  </p>
                </div>

                <div class="flex flex-col sm:flex-row w-full lg:w-auto gap-3 shrink-0">
                  <a
                    href={filamentDryerAmazonUrl}
                    target="_blank"
                    rel="noopener noreferrer sponsored"
                    class="text-center bg-neutral-950 hover:bg-neutral-800 text-white font-medium px-4 py-2 text-sm uppercase tracking-wider font-mono transition-none"
                  >
                    Filament Dryer Box ($39) ↗
                  </a>
                  <a
                    href={buildPlateGlueAmazonUrl}
                    target="_blank"
                    rel="noopener noreferrer sponsored"
                    class="text-center bg-neutral-950 hover:bg-neutral-800 text-white font-medium px-4 py-2 text-sm uppercase tracking-wider font-mono transition-none"
                  >
                    Textured PEI Plate / Liquid Glue ($16) ↗
                  </a>
                </div>
              </div>
            </div>
          )}

          <!-- Primary Certified Filament Spool Requirement Box -->
          <div class="border border-neutral-300 bg-neutral-50 p-5 sm:p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-2 mb-1.5">
                <span class="bg-neutral-950 text-white font-mono uppercase text-xs px-2.5 py-1">
                  PRIMARY CONSUMABLE SPEC
                </span>
                <span class="font-mono tabular-nums text-xs text-neutral-600 uppercase">
                  DIAMETER: 1.75MM ±0.02MM // 1.0 KG SPOOL
                </span>
              </div>
              <h3 class="text-lg font-black uppercase tracking-tight text-neutral-950">
                {filament.name} ({filament.brand} {filament.materialType})
              </h3>
              <p class="text-xs sm:text-sm text-neutral-700 mt-0.5">
                Reference polymer calibrated for {deterministicMath.effectiveVolumetricFlowMm3s} mm³/s volumetric flow on {printer.name}.
              </p>
            </div>

            <a
              href={primaryFilamentAmazonUrl}
              target="_blank"
              rel="noopener noreferrer sponsored"
              class="w-full md:w-auto shrink-0 text-center bg-neutral-950 hover:bg-neutral-800 text-white font-medium px-4 py-2 text-sm uppercase tracking-wider font-mono transition-none"
            >
              Buy {filament.name} (1kg Spool) on Amazon ↗
            </a>
          </div>
        </div>
      </section>

      <!-- 04. ORCASLICER PARAMETER OVERRIDES & COMPLETE TELEMETRY TABLE -->
      <section class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-neutral-200">
        <!-- Left 8 Cols: 4 Specific Slicer Tweaks -->
        <div class="lg:col-span-8 divide-y divide-neutral-200">
          <div class="p-6 sm:px-8 bg-neutral-100">
            <span class="bg-neutral-950 text-white font-mono uppercase text-xs px-2.5 py-1">
              04 // ORCASLICER PROCESS OVERRIDES
            </span>
            <h2 class="text-xl font-black uppercase tracking-tight text-neutral-950 mt-2">
              4 Calibrated Slicer Adjustments for {printer.name}
            </h2>
          </div>

          <div class="divide-y divide-neutral-200">
            {page.slicerTweaks.map((tweak, index) => (
              <div class="p-6 sm:px-8 flex items-start gap-5 bg-white">
                <span class="bg-neutral-950 text-white font-mono tabular-nums uppercase text-xs px-2.5 py-1 shrink-0 mt-0.5">
