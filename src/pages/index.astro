---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  loadAllSeeds,
  loadGeneratedPages,
  type PrinterSpec,
  type FilamentSpec,
} from '../utils/data';

const allSeeds = loadAllSeeds();
const generatedPages = loadGeneratedPages();
const generatedSlugSet = new Set(generatedPages.map((p) => p.slug));
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p: string) => `${BASE}${p.startsWith('/') ? p : '/' + p}`;

// Deduplicate printers & filaments
const printersMap = new Map<string, PrinterSpec>();
const filamentsMap = new Map<string, FilamentSpec>();

for (const seed of allSeeds) {
  if (!printersMap.has(seed.printer.slug)) {
    printersMap.set(seed.printer.slug, seed.printer);
  }
  if (!filamentsMap.has(seed.filament.slug)) {
    filamentsMap.set(seed.filament.slug, seed.filament);
  }
}

const printers = Array.from(printersMap.values());
const filaments = Array.from(filamentsMap.values());

const title = 'SlicerMatrix — Instant 3D Printer & Filament Settings';
const description =
  'Type your 3D printer and filament to get exact OrcaSlicer temperatures, volumetric speeds, nozzle warnings, and downloadable presets.';
---

<BaseLayout title={title} description={description}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
    <!-- CLEAN HERO + INSTANT TYPEABLE SEARCH BOX -->
    <section class="mb-16">
      <div class="max-w-3xl mb-8">
        <span class="bg-neutral-950 text-white font-mono uppercase text-xs px-2.5 py-1 inline-block mb-4">
          {allSeeds.length.toLocaleString()} Calibrated Combinations
        </span>
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-neutral-950 leading-[1.05] mb-3">
          Exact 3D Printer &amp; Filament Settings.
        </h1>
        <p class="text-lg text-neutral-600">
          Type your printer and filament below for instant temperatures, safe print speeds, and OrcaSlicer presets.
        </p>
      </div>

      <!-- Swiss Modular Search Box -->
      <div class="bg-white border border-neutral-300 shadow-sm p-5 sm:p-7">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
          <!-- Typeable Printer Combobox -->
          <div class="md:col-span-5 relative">
            <label for="matcher-printer-input" class="block text-xs font-semibold uppercase tracking-wider text-neutral-500 mb-2">
              1. Your 3D Printer
            </label>
            <div class="relative">
              <input
                id="matcher-printer-input"
                type="text"
                autocomplete="off"
                placeholder="Type printer (e.g. Bambu P1S, K1 Max)..."
                value={printers[0]?.name || ''}
                data-selected-slug={printers[0]?.slug || ''}
                class="w-full bg-neutral-50 border border-neutral-300 focus:bg-white focus:border-neutral-950 px-4 py-3.5 pr-10 text-base font-semibold text-neutral-950 placeholder-neutral-400 focus:outline-none transition-colors"
              />
              <button
                type="button"
                id="clear-printer-btn"
                title="Clear"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-neutral-400 hover:text-neutral-900 text-sm font-mono p-1 cursor-pointer"
              >
                ✕
              </button>
            </div>

            <!-- Typeable Dropdown Results -->
            <ul
              id="matcher-printer-list"
              class="hidden absolute z-30 left-0 right-0 top-full mt-1 bg-white border border-neutral-950 divide-y divide-neutral-100 max-h-64 overflow-y-auto shadow-xl"
            >
              {printers.map((p) => (
                <li
                  data-slug={p.slug}
                  data-name={p.name}
                  data-search={`${p.name} ${p.vendor}`.toLowerCase()}
                  class="printer-option px-4 py-3 hover:bg-neutral-950 hover:text-white cursor-pointer flex items-center justify-between text-sm transition-colors"
                >
                  <span class="font-semibold">{p.name}</span>
                  <span class="text-xs font-mono tabular-nums opacity-60">{p.defaultNozzleMaterial}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Typeable Filament Combobox -->
          <div class="md:col-span-5 relative">
            <label for="matcher-filament-input" class="block text-xs font-semibold uppercase tracking-wider text-neutral-500 mb-2">
              2. Your Filament
            </label>
            <div class="relative">
              <input
                id="matcher-filament-input"
                type="text"
                autocomplete="off"
                placeholder="Type filament (e.g. PolyLite PETG, PLA-CF)..."
                value={filaments[0]?.name || ''}
                data-selected-slug={filaments[0]?.slug || ''}
                class="w-full bg-neutral-50 border border-neutral-300 focus:bg-white focus:border-neutral-950 px-4 py-3.5 pr-10 text-base font-semibold text-neutral-950 placeholder-neutral-400 focus:outline-none transition-colors"
              />
              <button
                type="button"
                id="clear-filament-btn"
                title="Clear"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-neutral-400 hover:text-neutral-900 text-sm font-mono p-1 cursor-pointer"
              >
                ✕
              </button>
            </div>

            <!-- Typeable Dropdown Results -->
            <ul
              id="matcher-filament-list"
              class="hidden absolute z-30 left-0 right-0 top-full mt-1 bg-white border border-neutral-950 divide-y divide-neutral-100 max-h-64 overflow-y-auto shadow-xl"
            >
              {filaments.map((f) => (
                <li
                  data-slug={f.slug}
                  data-name={f.name}
                  data-search={`${f.name} ${f.brand} ${f.materialType}`.toLowerCase()}
                  class="filament-option px-4 py-3 hover:bg-neutral-950 hover:text-white cursor-pointer flex items-center justify-between text-sm transition-colors"
                >
                  <span class="font-semibold">{f.name}</span>
                  <span class="text-xs font-mono tabular-nums opacity-60">{f.materialType}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Action Button -->
          <div class="md:col-span-2">
            <button
              id="matcher-go-btn"
              type="button"
              class="w-full bg-orange-600 hover:bg-orange-500 text-white font-semibold px-4 py-3.5 text-sm uppercase tracking-wider cursor-pointer transition-colors"
            >
              Get Settings →
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- VERIFIED PROFILES (Visual Metric Cards, Minimal Text) -->
    <section id="verified-profiles" class="mb-16">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-bold text-neutral-950">Ready-to-Use Profiles</h2>
          <p class="text-sm text-neutral-500">Complete with speed calculator &amp; 1-click OrcaSlicer download</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-neutral-300 divide-y md:divide-y-0 md:divide-x divide-neutral-200 bg-white">
        {generatedPages.map((page) => {
          const isUpgrade = page.compatibilityVerdict === 'Requires Upgrade';
          return (
            <a
              href={withBase(`/${page.slug}/`)}
              class="group p-6 hover:bg-neutral-50 transition-colors flex flex-col justify-between border-b border-neutral-200"
            >
              <div>
                <div class="flex items-center justify-between gap-2 mb-4">
                  <span
                    class={`font-mono uppercase text-xs px-2.5 py-1 ${
                      isUpgrade ? 'bg-amber-500 text-neutral-950 font-bold' : 'bg-neutral-950 text-white'
                    }`}
                  >
                    {page.compatibilityVerdict}
                  </span>
                  <span class="text-xs font-mono text-neutral-500">{page.filament.materialType}</span>
                </div>

                <div class="text-xs font-medium text-neutral-400 uppercase tracking-wider mb-1">
                  {page.printer.name}
                </div>
                <h3 class="text-xl font-bold text-neutral-950 group-hover:text-orange-600 transition-colors mb-6">
                  {page.filament.name}
                </h3>
              </div>

              <!-- Big Scannable Numbers Only -->
              <div class="grid grid-cols-3 divide-x divide-neutral-200 border-t border-neutral-200 pt-4 font-mono tabular-nums">
                <div>
                  <span class="block text-[10px] text-neutral-400 uppercase">Nozzle</span>
                  <span class="text-lg font-bold text-neutral-950">{page.deterministicMath.recommendedNozzleTempC}°C</span>
                </div>
                <div class="pl-3">
                  <span class="block text-[10px] text-neutral-400 uppercase">Bed</span>
                  <span class="text-lg font-bold text-neutral-950">{page.deterministicMath.recommendedBedTempC}°C</span>
                </div>
                <div class="pl-3">
                  <span class="block text-[10px] text-neutral-400 uppercase">Max Speed</span>
                  <span class="text-lg font-bold text-emerald-600">{page.deterministicMath.calculatedMaxPrintSpeedMmS} <small class="text-xs font-normal">mm/s</small></span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- BROWSE BY 3D PRINTER -->
    <section id="printers" class="mb-16">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-5">
        <h2 class="text-2xl font-bold text-neutral-950">Browse by 3D Printer</h2>
        <input
          id="printer-hub-search"
          type="search"
          placeholder="Filter printers..."
          class="w-full sm:w-64 px-3.5 py-2 bg-white border border-neutral-300 focus:border-neutral-950 text-sm text-neutral-950 placeholder-neutral-400 focus:outline-none"
        />
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 border border-neutral-300 divide-x divide-y divide-neutral-200 bg-white" id="printer-hubs-grid">
        {printers.map((printer) => (
          <a
            href={withBase(`/printer/${printer.slug}/`)}
            data-search={`${printer.name} ${printer.vendor}`.toLowerCase()}
            class="printer-hub-card group p-4 hover:bg-neutral-50 transition-colors flex flex-col justify-between"
          >
            <div>
              <span class="text-[11px] font-medium text-neutral-400 block mb-0.5">{printer.vendor}</span>
              <h3 class="font-bold text-neutral-950 group-hover:text-orange-600 text-sm sm:text-base transition-colors">
                {printer.name}
              </h3>
            </div>
            <div class="mt-3 pt-2 border-t border-neutral-100 flex items-center justify-between text-xs font-mono tabular-nums text-neutral-500">
              <span>{printer.maxNozzleTempC}°C</span>
              <span class="text-neutral-900 font-semibold group-hover:text-orange-600">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- BROWSE BY FILAMENT -->
    <section id="filaments">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-5">
        <h2 class="text-2xl font-bold text-neutral-950">Browse by Filament</h2>
        <input
          id="filament-hub-search"
          type="search"
          placeholder="Filter filaments..."
          class="w-full sm:w-64 px-3.5 py-2 bg-white border border-neutral-300 focus:border-neutral-950 text-sm text-neutral-950 placeholder-neutral-400 focus:outline-none"
        />
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 border border-neutral-300 divide-x divide-y divide-neutral-200 bg-white" id="filament-hubs-grid">
        {filaments.map((filament) => (
          <a
            href={withBase(`/filament/${filament.slug}/`)}
            data-search={`${filament.name} ${filament.brand} ${filament.materialType}`.toLowerCase()}
            class="filament-hub-card group p-4 hover:bg-neutral-50 transition-colors flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between gap-1 mb-1">
                <span class="text-[11px] font-medium text-neutral-400">{filament.brand}</span>
                <span class="text-[10px] font-mono bg-neutral-100 text-neutral-700 px-1.5 py-0.5">{filament.materialType}</span>
              </div>
              <h3 class="font-bold text-neutral-950 group-hover:text-orange-600 text-sm transition-colors">
                {filament.name}
              </h3>
            </div>
            <div class="mt-3 pt-2 border-t border-neutral-100 flex items-center justify-between text-xs font-mono tabular-nums text-neutral-500">
              <span>{filament.minNozzleTempC}–{filament.maxNozzleTempC}°C</span>
              <span class="text-neutral-900 font-semibold group-hover:text-orange-600">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>

  <script define:vars={{ generatedSlugs: Array.from(generatedSlugSet), basePath: BASE }}>
    const generatedSet = new Set(generatedSlugs);

    function setupTypeableCombobox({ inputId, listId, clearBtnId, optionSelector }) {
      const input = document.getElementById(inputId);
      const list = document.getElementById(listId);
      const clearBtn = document.getElementById(clearBtnId);
      const options = Array.from(document.querySelectorAll(optionSelector));

      if (!input || !list) return;

      function filterOptions(query) {
        const q = query.trim().toLowerCase();
        let visibleCount = 0;
        options.forEach((li) => {
          const hay = li.getAttribute('data-search') || '';
          const match = !q || hay.includes(q);
          li.style.display = match ? '' : 'none';
          if (match) visibleCount++;
        });
        list.classList.toggle('hidden', visibleCount === 0);
      }

      function selectOption(li) {
        input.value = li.getAttribute('data-name') || '';
        input.setAttribute('data-selected-slug', li.getAttribute('data-slug') || '');
        list.classList.add('hidden');
      }

      input.addEventListener('focus', () => {
        input.select();
        filterOptions('');
      });

      input.addEventListener('input', () => {
        filterOptions(input.value);
        const q = input.value.trim().toLowerCase();
        const firstMatch = options.find((li) => (li.getAttribute('data-search') || '').includes(q));
        if (firstMatch) {
          input.setAttribute('data-selected-slug', firstMatch.getAttribute('data-slug') || '');
        }
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const q = input.value.trim().toLowerCase();
          const firstMatch = options.find((li) => (li.getAttribute('data-search') || '').includes(q));
          if (firstMatch) selectOption(firstMatch);
        } else if (e.key === 'Escape') {
          list.classList.add('hidden');
        }
      });

      options.forEach((li) => {
        li.addEventListener('mousedown', (e) => {
          e.preventDefault();
          selectOption(li);
        });
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          input.value = '';
          input.focus();
          filterOptions('');
        });
      }

      document.addEventListener('click', (e) => {
        if (!input.contains(e.target) && !list.contains(e.target) && (!clearBtn || !clearBtn.contains(e.target))) {
          list.classList.add('hidden');
        }
      });
    }

    setupTypeableCombobox({
      inputId: 'matcher-printer-input',
      listId: 'matcher-printer-list',
      clearBtnId: 'clear-printer-btn',
      optionSelector: '.printer-option',
    });

    setupTypeableCombobox({
      inputId: 'matcher-filament-input',
      listId: 'matcher-filament-list',
      clearBtnId: 'clear-filament-btn',
      optionSelector: '.filament-option',
    });

    const printerInput = document.getElementById('matcher-printer-input');
    const filamentInput = document.getElementById('matcher-filament-input');
    const goBtn = document.getElementById('matcher-go-btn');

    if (goBtn && printerInput && filamentInput) {
      goBtn.addEventListener('click', () => {
        const pSlug = printerInput.getAttribute('data-selected-slug') || 'bambu-lab-p1s';
        const fSlug = filamentInput.getAttribute('data-selected-slug') || 'polymaker-polylite-petg';
        const comboSlug = `${pSlug}-${fSlug}-settings`;
        if (generatedSet.has(comboSlug)) {
          window.location.href = `${basePath}/${comboSlug}/`;
        } else {
          window.location.href = `${basePath}/printer/${pSlug}/#${comboSlug}`;
        }
      });
    }

    function bindFilter(inputId, cardSelector) {
      const input = document.getElementById(inputId);
      const cards = document.querySelectorAll(cardSelector);
      if (!input) return;
      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        cards.forEach((card) => {
          const hay = card.getAttribute('data-search') || '';
          card.style.display = hay.includes(q) ? '' : 'none';
        });
      });
    }

    bindFilter('printer-hub-search', '.printer-hub-card');
    bindFilter('filament-hub-search', '.filament-hub-card');
  </script>
</BaseLayout>
