---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PUBLIC_AMAZON_AFFILIATE_TAG } from '../../config';
import {
  loadAllSeeds,
  loadGeneratedSlugsSet,
  type SeedItem,
  type PrinterSpec,
} from '../../utils/data';

export function getStaticPaths() {
  const allSeeds = loadAllSeeds();
  const generatedSet = loadGeneratedSlugsSet();

  const byPrinter = new Map<string, { printer: PrinterSpec; items: Array<SeedItem & { isGenerated: boolean }> }>();

  for (const seed of allSeeds) {
    const pSlug = seed.printer.slug;
    if (!byPrinter.has(pSlug)) {
      byPrinter.set(pSlug, { printer: seed.printer, items: [] });
    }
    byPrinter.get(pSlug)!.items.push({
      ...seed,
      isGenerated: generatedSet.has(seed.slug),
    });
  }

  return Array.from(byPrinter.entries()).map(([printerSlug, data]) => ({
    params: { printerSlug },
    props: {
      printer: data.printer,
      combinations: data.items,
      allPrinters: Array.from(byPrinter.values()).map((v) => v.printer),
    },
  }));
}

interface Props {
  printer: PrinterSpec;
  combinations: Array<SeedItem & { isGenerated: boolean }>;
  allPrinters: PrinterSpec[];
}

const { printer, combinations, allPrinters } = Astro.props;
const AFFILIATE_TAG = PUBLIC_AMAZON_AFFILIATE_TAG;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p: string) => `${BASE}${p.startsWith('/') ? p : '/' + p}`;

const nozzleUpgradeUrl = `https://www.amazon.com/s?k=${encodeURIComponent(
  printer.name + ' hardened steel nozzle 0.4mm 0.6mm'
)}&tag=${AFFILIATE_TAG}`;

const peiPlateUrl = `https://www.amazon.com/s?k=${encodeURIComponent(
  printer.name + ' textured PEI build plate'
)}&tag=${AFFILIATE_TAG}`;

const title = `${printer.name} Filament Settings & OrcaSlicer Matrix (${combinations.length} Polymers)`;
const description = `Complete Swiss metrology specification matrix of ${combinations.length} filament profiles for the ${printer.name} (${printer.extruderType}, ${printer.maxNozzleTempC}°C hotend, ${printer.maxVolumetricFlowBaseline} mm³/s baseline flow).`;
---

<BaseLayout title={title} description={description}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <nav
      aria-label="Breadcrumb"
      class="border border-b-0 border-neutral-300 bg-neutral-100 px-4 py-2.5 flex items-center justify-between text-[11px] font-mono uppercase tracking-wider text-neutral-600"
    >
      <div class="flex items-center gap-2">
        <a href={withBase('/')} class="hover:text-orange-600 font-bold text-neutral-950">INDEX</a>
        <span>/</span>
        <a href={withBase('/#printers')} class="hover:text-orange-600">PRINTERS</a>
        <span>/</span>
        <span class="text-neutral-950 font-semibold">{printer.name}</span>
      </div>
      <span class="font-mono tabular-nums">SYS // {printer.slug.toUpperCase()}</span>
    </nav>

    <!-- Single Cohesive Swiss Grid -->
    <div class="divide-y divide-neutral-200 border border-neutral-300 bg-white">
      <!-- Printer Hub Header -->
      <section class="divide-y divide-neutral-200">
        <div class="p-6 sm:p-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="bg-neutral-950 text-white font-mono uppercase text-xs px-2.5 py-1">
                {printer.vendor} HARDWARE HUB
              </span>
              <span class="border border-neutral-300 bg-neutral-50 text-neutral-900 font-mono uppercase text-xs px-2.5 py-1">
                {printer.extruderType}
              </span>
              <span class="border border-neutral-300 bg-neutral-50 text-neutral-900 font-mono uppercase text-xs px-2.5 py-1">
                {printer.enclosed ? 'ENCLOSED CHAMBER' : 'OPEN FRAME'}
              </span>
            </div>
            <h1 class="text-3xl sm:text-5xl font-black text-neutral-950 uppercase tracking-tight mb-3">
              {printer.name} Filament & OrcaSlicer Matrix
            </h1>
            <p class="text-neutral-700 text-sm sm:text-base max-w-3xl leading-relaxed">
              Deterministic nozzle temperatures, bed thermal limits, volumetric flow ceilings, and abrasive nozzle diagnostics across {combinations.length} polymers on the {printer.name}.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a
              href={nozzleUpgradeUrl}
              target="_blank"
              rel="noopener noreferrer sponsored"
              class="text-center bg-neutral-950 hover:bg-neutral-800 text-white font-medium px-4 py-2 text-sm uppercase tracking-wider font-mono transition-none"
            >
              {printer.name} Hardened Nozzle ↗
            </a>
            <a
              href={peiPlateUrl}
              target="_blank"
              rel="noopener noreferrer sponsored"
              class="text-center border border-neutral-950 bg-white hover:bg-neutral-100 text-neutral-950 font-medium px-4 py-2 text-sm uppercase tracking-wider font-mono transition-none"
            >
              Textured PEI Plate ↗
            </a>
          </div>
        </div>

        <!-- 4-Column Hardware Spec Bar -->
        <div class="grid grid-cols-2 sm:grid-cols-4 divide-y sm:divide-y-0 divide-x divide-neutral-200 bg-neutral-50 font-mono tabular-nums">
          <div class="p-6">
            <span class="block text-[11px] uppercase text-neutral-500 mb-1">MAX HOTEND TEMP</span>
            <div class="text-3xl font-bold text-neutral-950">{printer.maxNozzleTempC}°C</div>
          </div>
          <div class="p-6">
            <span class="block text-[11px] uppercase text-neutral-500 mb-1">MAX HEATED BED</span>
            <div class="text-3xl font-bold text-neutral-950">{printer.maxBedTempC}°C</div>
          </div>
          <div class="p-6">
            <span class="block text-[11px] uppercase text-neutral-500 mb-1">STOCK NOZZLE MATERIAL</span>
            <div class="text-2xl font-bold text-orange-600 uppercase">{printer.defaultNozzleMaterial}</div>
          </div>
          <div class="p-6">
            <span class="block text-[11px] uppercase text-neutral-500 mb-1">VOLUMETRIC BASELINE</span>
            <div class="text-3xl font-bold text-emerald-700">{printer.maxVolumetricFlowBaseline} mm³/s</div>
          </div>
        </div>
      </section>

      <!-- Typeable Filter & Filament Matrix Table -->
      <section class="divide-y divide-neutral-200">
        <div class="p-6 bg-neutral-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <span class="bg-neutral-950 text-white font-mono uppercase text-xs px-2.5 py-1">
              POLYMER COMPATIBILITY REGISTER
            </span>
            <h2 class="text-xl font-black text-neutral-950 uppercase tracking-tight mt-2">
              {combinations.length} Calibrated Filament Profiles for {printer.name}
            </h2>
          </div>

          <div class="w-full sm:w-96">
            <label for="printer-filament-filter" class="block text-[10px] font-mono uppercase text-neutral-600 mb-1">
              TYPE TO FILTER FILAMENTS (E.G. PETG, PLA-CF, TPU, PA6)
            </label>
            <input
              id="printer-filament-filter"
              type="search"
              placeholder={`TYPE TO SEARCH ${printer.name.toUpperCase()} FILAMENTS...`}
              class="w-full px-3.5 py-2.5 bg-white border-2 border-neutral-950 text-xs font-mono text-neutral-950 placeholder-neutral-400 focus:outline-none focus:border-orange-600"
            />
          </div>
        </div>

        <div class="overflow-x-auto bg-white">
          <table class="w-full text-left border-collapse divide-y divide-neutral-200">
            <thead>
              <tr class="bg-neutral-50 text-[11px] font-mono uppercase text-neutral-500 divide-x divide-neutral-200">
                <th class="py-3.5 px-4">Polymer Spool</th>
                <th class="py-3.5 px-4">Class</th>
                <th class="py-3.5 px-4">Nozzle / Bed</th>
                <th class="py-3.5 px-4">Volumetric Cap</th>
                <th class="py-3.5 px-4">Safe Speed</th>
                <th class="py-3.5 px-4">Engineering Advisories</th>
                <th class="py-3.5 px-4 text-right">Spec / Consumable</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-200 text-sm font-mono tabular-nums" id="printer-matrix-tbody">
              {combinations
                .sort((a, b) => Number(b.isGenerated) - Number(a.isGenerated))
                .map((item) => {
                  const amazonFilamentLink = `https://www.amazon.com/s?k=${encodeURIComponent(
                    item.filament.name + ' 1.75mm 1kg'
                  )}&tag=${AFFILIATE_TAG}`;
                  return (
                    <tr
                      id={item.slug}
                      data-search={`${item.filament.name} ${item.filament.brand} ${item.filament.materialType}`.toLowerCase()}
                      class="hover:bg-neutral-100 divide-x divide-neutral-200 transition-none"
                    >
                      <td class="py-3.5 px-4 font-sans font-bold text-neutral-950">
                        <div class="flex items-center gap-2">
                          {item.isGenerated && (
                            <span
                              class="inline-block w-2 h-2 bg-emerald-600 shrink-0"
                              title="Full Verified OrcaSlicer Spec Sheet"
                            ></span>
                          )}
                          <a
                            href={item.isGenerated ? withBase(`/${item.slug}/`) : withBase(`/filament/${item.filament.slug}/`)}
                            class="hover:text-orange-600 uppercase tracking-tight"
                          >
                            {item.filament.name}
                          </a>
                        </div>
                      </td>
                      <td class="py-3.5 px-4 text-xs">
                        <span class="bg-neutral-950 text-white px-2 py-0.5 uppercase">
                          {item.filament.materialType}
                        </span>
                      </td>
                      <td class="py-3.5 px-4 text-xs">
                        <span class="font-bold text-neutral-950">{item.deterministicMath.recommendedNozzleTempC}°C</span>
                        <span class="text-neutral-400"> / </span>
                        <span class="text-neutral-700">{item.deterministicMath.recommendedBedTempC}°C</span>
                      </td>
                      <td class="py-3.5 px-4 text-xs font-bold text-emerald-700">
                        {item.deterministicMath.effectiveVolumetricFlowMm3s} mm³/s
                      </td>
                      <td class="py-3.5 px-4 text-xs font-bold text-neutral-950">
                        {item.deterministicMath.calculatedMaxPrintSpeedMmS} mm/s
                      </td>
                      <td class="py-3.5 px-4">
                        <div class="flex flex-wrap gap-1.5 text-[10px] uppercase">
                          {item.deterministicMath.requiresHardenedNozzleUpgrade && (
                            <span class="border border-amber-600 bg-amber-50 text-amber-950 px-2 py-0.5 font-bold">
                              ⚠️ HARDENED NOZZLE REQ
                            </span>
                          )}
                          {item.deterministicMath.requiresFilamentDryer && (
                            <span class="border border-neutral-400 bg-neutral-100 text-neutral-800 px-2 py-0.5">
                              DRY SPOOL
                            </span>
                          )}
                          {item.deterministicMath.enclosureWarning && (
                            <span class="border border-red-600 bg-red-50 text-red-900 px-2 py-0.5 font-bold">
                              ENCLOSURE REQ
                            </span>
                          )}
                          {!item.deterministicMath.requiresHardenedNozzleUpgrade &&
                            !item.deterministicMath.enclosureWarning && (
                              <span class="bg-neutral-950 text-emerald-400 px-2 py-0.5">
                                ● STOCK READY
                              </span>
                            )}
                        </div>
                      </td>
                      <td class="py-3.5 px-4 text-right">
                        <div class="inline-flex items-center gap-2">
                          {item.isGenerated ? (
                            <a
                              href={withBase(`/${item.slug}/`)}
                              class="bg-neutral-950 hover:bg-neutral-800 text-white font-medium px-3 py-1.5 text-xs uppercase tracking-wider transition-none"
                            >
                              SPEC SHEET →
                            </a>
                          ) : (
                            <a
                              href={withBase(`/filament/${item.filament.slug}/`)}
                              class="border border-neutral-400 bg-white hover:bg-neutral-200 text-neutral-900 px-3 py-1.5 text-xs uppercase tracking-wider transition-none"
                            >
                              POLYMER HUB
                            </a>
                          )}
                          <a
                            href={amazonFilamentLink}
                            target="_blank"
                            rel="noopener noreferrer sponsored"
                            class="bg-neutral-950 hover:bg-neutral-800 text-white font-medium px-3 py-1.5 text-xs uppercase tracking-wider transition-none"
                            title={`Buy ${item.filament.name} on Amazon`}
                          >
                            SPOOL ↗
                          </a>
                        </div>
                      </td>
                    </tr>
                  );
                })}
            </tbody>
          </table>
        </div>
      </section>

      <!-- All Printers Index Mesh -->
      <section class="p-6 sm:p-8 bg-neutral-50">
        <h2 class="text-xs font-mono uppercase tracking-widest text-neutral-500 mb-4">
           CROSS-REFERENCE // OTHER 3D PRINTER HARDWARE SYSTEMS
        </h2>
        <div class="flex flex-wrap gap-2">
          {allPrinters.map((p) => (
            <a
              href={withBase(`/printer/${p.slug}/`)}
              class={`px-3 py-1.5 text-xs font-mono uppercase border transition-none ${
                p.slug === printer.slug
                  ? 'bg-neutral-950 text-white border-neutral-950 font-bold'
                  : 'bg-white text-neutral-900 border-neutral-300 hover:border-neutral-950'
              }`}
            >
              {p.name}
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>

  <script>
    const filterInput = document.getElementById('printer-filament-filter') as HTMLInputElement | null;
    const rows = document.querySelectorAll('#printer-matrix-tbody tr');
    if (filterInput) {
      filterInput.addEventListener('input', () => {
        const q = filterInput.value.trim().toLowerCase();
        rows.forEach((row) => {
          const hay = row.getAttribute('data-search') || '';
          (row as HTMLElement).style.display = hay.includes(q) ? '' : 'none';
        });
      });
    }
  </script>
</BaseLayout>
