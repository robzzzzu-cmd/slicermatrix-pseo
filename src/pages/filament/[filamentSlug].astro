---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PUBLIC_AMAZON_AFFILIATE_TAG } from '../../config';
import {
  loadAllSeeds,
  loadGeneratedSlugsSet,
  type SeedItem,
  type FilamentSpec,
} from '../../utils/data';

export function getStaticPaths() {
  const allSeeds = loadAllSeeds();
  const generatedSet = loadGeneratedSlugsSet();

  const byFilament = new Map<string, { filament: FilamentSpec; items: Array<SeedItem & { isGenerated: boolean }> }>();

  for (const seed of allSeeds) {
    const fSlug = seed.filament.slug;
    if (!byFilament.has(fSlug)) {
      byFilament.set(fSlug, { filament: seed.filament, items: [] });
    }
    byFilament.get(fSlug)!.items.push({
      ...seed,
      isGenerated: generatedSet.has(seed.slug),
    });
  }

  return Array.from(byFilament.entries()).map(([filamentSlug, data]) => ({
    params: { filamentSlug },
    props: {
      filament: data.filament,
      combinations: data.items,
      allFilaments: Array.from(byFilament.values()).map((v) => v.filament),
    },
  }));
}

interface Props {
  filament: FilamentSpec;
  combinations: Array<SeedItem & { isGenerated: boolean }>;
  allFilaments: FilamentSpec[];
}

const { filament, combinations, allFilaments } = Astro.props;
const AFFILIATE_TAG = PUBLIC_AMAZON_AFFILIATE_TAG;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p: string) => `${BASE}${p.startsWith('/') ? p : '/' + p}`;

const buySpoolUrl = `https://www.amazon.com/s?k=${encodeURIComponent(
  filament.name + ' 1.75mm 1kg filament'
)}&tag=${AFFILIATE_TAG}`;

const title = `${filament.name} Settings (${combinations.length} 3D Printers)`;
const description = `Exact nozzle temperatures, bed temperatures, and safe print speeds for ${filament.name} across ${combinations.length} 3D printers.`;
---

<BaseLayout title={title} description={description}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Minimal Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-neutral-500 mb-6">
      <a href={withBase('/')} class="hover:text-neutral-950">Home</a>
      <span>/</span>
      <a href={withBase('/#filaments')} class="hover:text-neutral-950">Filaments</a>
      <span>/</span>
      <span class="text-neutral-900 font-medium">{filament.name}</span>
    </nav>

    <!-- Clean Filament Summary Card -->
    <div class="border border-neutral-300 bg-white divide-y divide-neutral-200 mb-8">
      <div class="p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span class="bg-neutral-950 text-white font-mono uppercase text-xs px-2.5 py-1 inline-block mb-3">
            {filament.brand} • {filament.materialType}
          </span>
          <h1 class="text-2xl sm:text-4xl font-extrabold text-neutral-950 tracking-tight">
            {filament.name} Printer Settings
          </h1>
        </div>
        <a
          href={buySpoolUrl}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="shrink-0 bg-neutral-950 hover:bg-neutral-800 text-white font-medium px-4 py-2.5 text-xs sm:text-sm uppercase tracking-wider"
        >
          Buy {filament.name} (1kg) on Amazon ↗
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 divide-y sm:divide-y-0 divide-x divide-neutral-200 bg-neutral-50/60 font-mono tabular-nums">
        <div class="p-4 sm:p-5">
          <span class="block text-[11px] uppercase text-neutral-400">Nozzle Temp</span>
          <span class="text-2xl font-bold text-neutral-950">{filament.minNozzleTempC}–{filament.maxNozzleTempC}°C</span>
        </div>
        <div class="p-4 sm:p-5">
          <span class="block text-[11px] uppercase text-neutral-400">Bed Temp</span>
          <span class="text-2xl font-bold text-neutral-950">{filament.minBedTempC}–{filament.maxBedTempC}°C</span>
        </div>
        <div class="p-4 sm:p-5">
          <span class="block text-[11px] uppercase text-neutral-400">Max Flow</span>
          <span class="text-2xl font-bold text-emerald-600">{filament.volumetricFlowLimitMm3s} mm³/s</span>
        </div>
        <div class="p-4 sm:p-5">
          <span class="block text-[11px] uppercase text-neutral-400">Nozzle Type</span>
          <span class="text-lg font-bold text-neutral-950">{filament.isAbrasive ? 'Hardened Req' : 'Any Nozzle'}</span>
        </div>
      </div>
    </div>

    <!-- Searchable Printer Table -->
    <div class="border border-neutral-300 bg-white divide-y divide-neutral-200 mb-10">
      <div class="p-4 sm:px-6 bg-neutral-50 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <h2 class="font-bold text-base text-neutral-950">All {combinations.length} 3D Printers</h2>
        <input
          id="filament-printer-filter"
          type="search"
          placeholder="Type to filter printers (e.g. Bambu, Creality, Voron)..."
          class="w-full sm:w-80 px-3.5 py-2 bg-white border border-neutral-300 focus:border-neutral-950 text-sm text-neutral-950 placeholder-neutral-400 focus:outline-none"
        />
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse divide-y divide-neutral-200">
          <thead>
            <tr class="bg-neutral-50/50 text-[11px] font-semibold uppercase tracking-wider text-neutral-400">
              <th class="py-3 px-4">3D Printer</th>
              <th class="py-3 px-4">Nozzle</th>
              <th class="py-3 px-4">Bed</th>
              <th class="py-3 px-4">Max Speed</th>
              <th class="py-3 px-4">Status</th>
              <th class="py-3 px-4 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-200 text-sm" id="filament-matrix-tbody">
            {combinations
              .sort((a, b) => Number(b.isGenerated) - Number(a.isGenerated))
              .map((item) => (
                <tr
                  id={item.slug}
                  data-search={`${item.printer.name} ${item.printer.vendor}`.toLowerCase()}
                  class="hover:bg-neutral-50 transition-colors"
                >
                  <td class="py-3.5 px-4 font-bold text-neutral-950">
                    <a
                      href={item.isGenerated ? withBase(`/${item.slug}/`) : withBase(`/printer/${item.printer.slug}/`)}
                      class="hover:text-orange-600"
                    >
                      {item.printer.name}
                    </a>
                  </td>
                  <td class="py-3.5 px-4 font-mono tabular-nums font-bold text-neutral-950">
                    {item.deterministicMath.recommendedNozzleTempC}°C
                  </td>
                  <td class="py-3.5 px-4 font-mono tabular-nums text-neutral-600">
                    {item.deterministicMath.recommendedBedTempC}°C
                  </td>
                  <td class="py-3.5 px-4 font-mono tabular-nums font-bold text-emerald-600">
                    {item.deterministicMath.calculatedMaxPrintSpeedMmS} mm/s
                  </td>
                  <td class="py-3.5 px-4 text-xs">
                    {item.deterministicMath.requiresHardenedNozzleUpgrade ? (
                      <span class="text-amber-700 font-semibold">⚠️ Upgrade Nozzle</span>
                    ) : (
                      <span class="text-emerald-700 font-medium">Ready</span>
                    )}
                  </td>
                  <td class="py-3.5 px-4 text-right">
                    {item.isGenerated ? (
                      <a
                        href={withBase(`/${item.slug}/`)}
                        class="bg-orange-600 hover:bg-orange-500 text-white font-medium px-3 py-1 text-xs uppercase tracking-wider"
                      >
                        Profile →
                      </a>
                    ) : (
                      <a
                        href={withBase(`/printer/${item.printer.slug}/`)}
                        class="bg-neutral-950 hover:bg-neutral-800 text-white font-medium px-3 py-1 text-xs uppercase tracking-wider"
                      >
                        Printer →
                      </a>
                    )}
                  </td>
                </tr>
              ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Other Filaments -->
    <div class="border border-neutral-300 bg-white p-5">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-3">Other Filaments</h3>
      <div class="flex flex-wrap gap-2">
        {allFilaments.map((f) => (
          <a
            href={withBase(`/filament/${f.slug}/`)}
            class={`px-3 py-1.5 text-xs font-medium border transition-colors ${
              f.slug === filament.slug
                ? 'bg-neutral-950 text-white border-neutral-950'
                : 'bg-neutral-50 text-neutral-700 border-neutral-200 hover:border-neutral-950'
            }`}
          >
            {f.name}
          </a>
        ))}
      </div>
    </div>
  </div>

  <script>
    const filterInput = document.getElementById('filament-printer-filter') as HTMLInputElement | null;
    const rows = document.querySelectorAll('#filament-matrix-tbody tr');
    if (filterInput) {
      filterInput.addEventListener('input', () => {
        const q = filterInput.value.trim().toLowerCase();
        rows.forEach((row) => {
          const hay = row.getAttribute('data-search') || '';
          (row as HTMLElement).style.display = hay.includes(q) ? '' : 'none';
        });
      });
    }
  </script>
</BaseLayout>
