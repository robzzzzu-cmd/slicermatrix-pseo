---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PUBLIC_AMAZON_AFFILIATE_TAG } from '../../config';
import {
  loadAllSeeds,
  loadGeneratedSlugsSet,
  type SeedItem,
  type FilamentSpec,
} from '../../utils/data';

export function getStaticPaths() {
  const allSeeds = loadAllSeeds();
  const generatedSet = loadGeneratedSlugsSet();

  const byFilament = new Map<string, { filament: FilamentSpec; items: Array<SeedItem & { isGenerated: boolean }> }>();

  for (const seed of allSeeds) {
    const fSlug = seed.filament.slug;
    if (!byFilament.has(fSlug)) {
      byFilament.set(fSlug, { filament: seed.filament, items: [] });
    }
    byFilament.get(fSlug)!.items.push({
      ...seed,
      isGenerated: generatedSet.has(seed.slug),
    });
  }

  return Array.from(byFilament.entries()).map(([filamentSlug, data]) => ({
    params: { filamentSlug },
    props: {
      filament: data.filament,
      combinations: data.items,
      allFilaments: Array.from(byFilament.values()).map((v) => v.filament),
    },
  }));
}

interface Props {
  filament: FilamentSpec;
  combinations: Array<SeedItem & { isGenerated: boolean }>;
  allFilaments: FilamentSpec[];
}

const { filament, combinations, allFilaments } = Astro.props;
const AFFILIATE_TAG = PUBLIC_AMAZON_AFFILIATE_TAG;

const buySpoolUrl = `https://www.amazon.com/s?k=${encodeURIComponent(
  filament.name + ' 1.75mm 1kg filament'
)}&tag=${AFFILIATE_TAG}`;

const dryerUrl = `https://www.amazon.com/s?k=${encodeURIComponent(
  '3D filament dryer box 70C'
)}&tag=${AFFILIATE_TAG}`;

const title = `${filament.name} 3D Printer Settings & Speed Matrix (${combinations.length} Printers)`;
const description = `Calibrated OrcaSlicer temperatures, volumetric flow ceilings (${filament.volumetricFlowLimitMm3s} mm³/s), and nozzle compatibility for ${filament.name} (${filament.materialType}) across ${combinations.length} 3D printers.`;
---

<BaseLayout title={title} description={description}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-mono text-slate-400 mb-6">
      <a href="/" class="hover:text-orange-400 transition-colors">Home</a>
      <span>/</span>
      <a href="/#filaments" class="hover:text-orange-400 transition-colors">Filaments</a>
      <span>/</span>
      <span class="text-slate-200">{filament.name}</span>
    </nav>

    <!-- Filament Hub Hero -->
    <section class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 sm:p-8 mb-8 shadow-xl">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="px-2.5 py-1 rounded-md text-xs font-mono font-semibold bg-amber-500/15 text-amber-300 border border-amber-500/30">
              {filament.brand} • {filament.materialType}
            </span>
            {filament.isAbrasive && (
              <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-red-500/15 text-red-300 border border-red-500/30">
                ⚠️ Abrasive (Hardened Nozzle Required)
              </span>
            )}
            {filament.isHygroscopic && (
              <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-sky-500/15 text-sky-300 border border-sky-500/30">
                Hygroscopic (Dry Before Print)
              </span>
            )}
          </div>
          <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight mb-2">
            {filament.name} Printer Compatibility & Slicer Settings
          </h1>
          <p class="text-slate-300 text-sm sm:text-base max-w-3xl">
            Compare exact nozzle temperatures ({filament.minNozzleTempC}–{filament.maxNozzleTempC}°C), heated bed ranges ({filament.minBedTempC}–{filament.maxBedTempC}°C), and max print speeds across {combinations.length} popular 3D printers.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href={buySpoolUrl}
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-400 hover:to-amber-400 text-slate-950 font-extrabold text-xs sm:text-sm shadow-lg shadow-orange-500/20 transition-all"
          >
            <span>Buy {filament.name} (1kg) on Amazon</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          {filament.isHygroscopic && (
            <a
              href={dryerUrl}
              target="_blank"
              rel="noopener noreferrer sponsored"
              class="inline-flex items-center justify-center gap-2 px-4 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-amber-300 border border-amber-500/30 font-bold text-xs sm:text-sm transition-all"
            >
              <span>70°C Filament Dryer Box</span>
            </a>
          )}
        </div>
      </div>

      <!-- Filament Material Spec Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6 pt-6 border-t border-slate-800/80">
        <div class="bg-slate-950/80 rounded-xl p-3.5 border border-slate-800">
          <span class="text-[11px] font-mono uppercase text-slate-400">Nozzle Temp Range</span>
          <div class="text-xl font-mono font-bold text-orange-400 mt-0.5">
            {filament.minNozzleTempC}–{filament.maxNozzleTempC}°C
          </div>
        </div>
        <div class="bg-slate-950/80 rounded-xl p-3.5 border border-slate-800">
          <span class="text-[11px] font-mono uppercase text-slate-400">Bed Temp Range</span>
          <div class="text-xl font-mono font-bold text-amber-300 mt-0.5">
            {filament.minBedTempC}–{filament.maxBedTempC}°C
          </div>
        </div>
        <div class="bg-slate-950/80 rounded-xl p-3.5 border border-slate-800">
          <span class="text-[11px] font-mono uppercase text-slate-400">Volumetric Flow Limit</span>
          <div class="text-xl font-mono font-bold text-emerald-400 mt-0.5">
            {filament.volumetricFlowLimitMm3s} mm³/s
          </div>
        </div>
        <div class="bg-slate-950/80 rounded-xl p-3.5 border border-slate-800">
          <span class="text-[11px] font-mono uppercase text-slate-400">Enclosure Required</span>
          <div class="text-xl font-mono font-bold text-white mt-0.5">
            {filament.requiresEnclosure ? 'Yes (Recommended)' : 'No (Open Frame OK)'}
          </div>
        </div>
      </div>
    </section>

    <!-- Printer Matrix Table for this Filament -->
    <section class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5 sm:p-8 mb-12">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="text-xl font-bold text-white">
            All {combinations.length} Supported 3D Printers for {filament.name}
          </h2>
          <p class="text-xs text-slate-400 font-mono mt-0.5">
            Click any printer to view hardware compatibility or download the OrcaSlicer profile
          </p>
        </div>
        <input
          id="filament-printer-filter"
          type="search"
          placeholder="Filter printers (e.g. Bambu, Creality, Voron)..."
          class="w-full sm:w-80 px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-orange-500"
        />
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-800 text-[11px] font-mono uppercase text-slate-400">
              <th class="py-3 px-3">3D Printer</th>
              <th class="py-3 px-3">Stock Nozzle</th>
              <th class="py-3 px-3">Target Temp</th>
              <th class="py-3 px-3">Effective Flow</th>
              <th class="py-3 px-3">Max Print Speed</th>
              <th class="py-3 px-3">Compatibility Status</th>
              <th class="py-3 px-3 text-right">Profile / Hardware</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/70 text-sm" id="filament-matrix-tbody">
            {combinations
              .sort((a, b) => Number(b.isGenerated) - Number(a.isGenerated))
              .map((item) => {
                const nozzleAmazonUrl = `https://www.amazon.com/s?k=${encodeURIComponent(
                  item.printer.name + ' hardened steel nozzle 0.4mm'
                )}&tag=${AFFILIATE_TAG}`;
                return (
                  <tr
                    id={item.slug}
                    data-search={`${item.printer.name} ${item.printer.vendor} ${item.printer.defaultNozzleMaterial}`.toLowerCase()}
                    class="hover:bg-slate-950/60 transition-colors"
                  >
                    <td class="py-3.5 px-3 font-medium text-white">
                      <div class="flex items-center gap-2">
                        {item.isGenerated && (
                          <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0" title="Full Verified OrcaSlicer Profile"></span>
                        )}
                        <a
                          href={item.isGenerated ? `/${item.slug}/` : `/printer/${item.printer.slug}/`}
                          class="hover:text-orange-400 transition-colors font-semibold"
                        >
                          {item.printer.name}
                        </a>
                      </div>
                    </td>
                    <td class="py-3.5 px-3 font-mono text-xs text-slate-300">
                      {item.printer.defaultNozzleMaterial}
                    </td>
                    <td class="py-3.5 px-3 font-mono text-xs">
                      <span class="text-orange-400 font-bold">{item.deterministicMath.recommendedNozzleTempC}°C</span>
                      <span class="text-slate-500"> / </span>
                      <span class="text-amber-300">{item.deterministicMath.recommendedBedTempC}°C</span>
                    </td>
                    <td class="py-3.5 px-3 font-mono text-xs text-emerald-400 font-semibold">
                      {item.deterministicMath.effectiveVolumetricFlowMm3s} mm³/s
                    </td>
                    <td class="py-3.5 px-3 font-mono text-xs text-white font-bold">
                      {item.deterministicMath.calculatedMaxPrintSpeedMmS} mm/s
                    </td>
                    <td class="py-3.5 px-3">
                      <div class="flex flex-wrap gap-1.5 text-[11px] font-mono">
                        {item.deterministicMath.requiresHardenedNozzleUpgrade ? (
                          <span class="px-2 py-0.5 rounded bg-red-500/15 text-red-300 border border-red-500/30">
                            ⚠️ Upgrade Nozzle
                          </span>
                        ) : item.deterministicMath.enclosureWarning ? (
                          <span class="px-2 py-0.5 rounded bg-amber-500/15 text-amber-300 border border-amber-500/30">
                            Enclosure Needed
                          </span>
                        ) : (
                          <span class="px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                            Optimal Match
                          </span>
                        )}
                      </div>
                    </td>
                    <td class="py-3.5 px-3 text-right">
                      <div class="inline-flex items-center gap-2">
                        {item.isGenerated ? (
                          <a
                            href={`/${item.slug}/`}
                            class="px-3 py-1.5 rounded-lg bg-orange-500 hover:bg-orange-400 text-slate-950 font-bold text-xs transition-colors"
                          >
                            Full Profile →
                          </a>
                        ) : (
                          <a
                            href={`/printer/${item.printer.slug}/`}
                            class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 font-mono text-xs border border-slate-700 transition-colors"
                          >
                            Printer Hub
                          </a>
                        )}
                        {item.deterministicMath.requiresHardenedNozzleUpgrade && (
                          <a
                            href={nozzleAmazonUrl}
                            target="_blank"
                            rel="noopener noreferrer sponsored"
                            class="px-2.5 py-1.5 rounded-lg bg-red-500/20 hover:bg-red-500/30 text-red-200 border border-red-500/40 font-mono text-xs transition-colors"
                          >
                            Hardened Nozzle
                          </a>
                        )}
                      </div>
                    </td>
                  </tr>
                );
              })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Other Filament Hubs Mesh -->
    <section class="rounded-2xl border border-slate-800 bg-slate-900/40 p-6">
      <h2 class="text-sm font-mono uppercase tracking-wider text-slate-400 mb-4">
        Explore Other Branded Filament Hubs
      </h2>
      <div class="flex flex-wrap gap-2">
        {allFilaments.map((f) => (
          <a
            href={`/filament/${f.slug}/`}
            class={`px-3 py-1.5 rounded-lg text-xs font-mono border transition-colors ${
              f.slug === filament.slug
                ? 'bg-amber-500 text-slate-950 border-amber-400 font-bold'
                : 'bg-slate-950 text-slate-300 border-slate-800 hover:border-amber-500/40'
            }`}
          >
            {f.name}
          </a>
        ))}
      </div>
    </section>
  </div>

  <script>
    const filterInput = document.getElementById('filament-printer-filter') as HTMLInputElement | null;
    const rows = document.querySelectorAll('#filament-matrix-tbody tr');
    if (filterInput) {
      filterInput.addEventListener('input', () => {
        const q = filterInput.value.trim().toLowerCase();
        rows.forEach((row) => {
          const hay = row.getAttribute('data-search') || '';
          (row as HTMLElement).style.display = hay.includes(q) ? '' : 'none';
        });
      });
    }
  </script>
</BaseLayout>
