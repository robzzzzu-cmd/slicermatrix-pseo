---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PUBLIC_AMAZON_AFFILIATE_TAG } from '../../config';
import {
  loadAllSeeds,
  loadGeneratedSlugsSet,
  type SeedItem,
  type FilamentSpec,
} from '../../utils/data';

export function getStaticPaths() {
  const allSeeds = loadAllSeeds();
  const generatedSet = loadGeneratedSlugsSet();

  const byFilament = new Map<string, { filament: FilamentSpec; items: Array<SeedItem & { isGenerated: boolean }> }>();

  for (const seed of allSeeds) {
    const fSlug = seed.filament.slug;
    if (!byFilament.has(fSlug)) {
      byFilament.set(fSlug, { filament: seed.filament, items: [] });
    }
    byFilament.get(fSlug)!.items.push({
      ...seed,
      isGenerated: generatedSet.has(seed.slug),
    });
  }

  return Array.from(byFilament.entries()).map(([filamentSlug, data]) => ({
    params: { filamentSlug },
    props: {
      filament: data.filament,
      combinations: data.items,
      allFilaments: Array.from(byFilament.values()).map((v) => v.filament),
    },
  }));
}

interface Props {
  filament: FilamentSpec;
  combinations: Array<SeedItem & { isGenerated: boolean }>;
  allFilaments: FilamentSpec[];
}

const { filament, combinations, allFilaments } = Astro.props;
const AFFILIATE_TAG = PUBLIC_AMAZON_AFFILIATE_TAG;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p: string) => `${BASE}${p.startsWith('/') ? p : '/' + p}`;

const buySpoolUrl = `https://www.amazon.com/s?k=${encodeURIComponent(
  filament.name + ' 1.75mm 1kg filament'
)}&tag=${AFFILIATE_TAG}`;

const dryerUrl = `https://www.amazon.com/s?k=${encodeURIComponent(
  '3D filament dryer box 70C'
)}&tag=${AFFILIATE_TAG}`;

const title = `${filament.name} 3D Printer Settings & Speed Matrix (${combinations.length} Printers)`;
const description = `Calibrated OrcaSlicer temperatures, volumetric flow ceilings (${filament.volumetricFlowLimitMm3s} mm³/s), and nozzle compatibility for ${filament.name} (${filament.materialType}) across ${combinations.length} 3D printers.`;
---

<BaseLayout title={title} description={description}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <nav
      aria-label="Breadcrumb"
      class="border border-b-0 border-neutral-300 bg-neutral-100 px-4 py-2.5 flex items-center justify-between text-[11px] font-mono uppercase tracking-wider text-neutral-600"
    >
      <div class="flex items-center gap-2">
        <a href={withBase('/')} class="hover:text-orange-600 font-bold text-neutral-950">INDEX</a>
        <span>/</span>
        <a href={withBase('/#filaments')} class="hover:text-orange-600">FILAMENTS</a>
        <span>/</span>
        <span class="text-neutral-950 font-semibold">{filament.name}</span>
      </div>
      <span class="font-mono tabular-nums">MAT // {filament.slug.toUpperCase()}</span>
    </nav>

    <!-- Single Cohesive Swiss Grid -->
    <div class="divide-y divide-neutral-200 border border-neutral-300 bg-white">
      <!-- Filament Hub Hero -->
      <section class="divide-y divide-neutral-200">
        <div class="p-6 sm:p-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="bg-neutral-950 text-white font-mono uppercase text-xs px-2.5 py-1">
                {filament.brand} // {filament.materialType}
              </span>
              {filament.isAbrasive && (
                <span class="border border-amber-600 bg-amber-50 text-amber-950 font-mono uppercase text-xs px-2.5 py-1 font-bold">
                  ⚠️ ABRASIVE POLYMER (HARDENED NOZZLE REQ)
                </span>
              )}
              {filament.isHygroscopic && (
                <span class="border border-neutral-400 bg-neutral-100 text-neutral-900 font-mono uppercase text-xs px-2.5 py-1">
                  HYGROSCOPIC (PRE-DRY SPOOL)
                </span>
              )}
            </div>
            <h1 class="text-3xl sm:text-5xl font-black text-neutral-950 uppercase tracking-tight mb-3">
              {filament.name} Printer Compatibility & Slicer Settings
            </h1>
            <p class="text-neutral-700 text-sm sm:text-base max-w-3xl leading-relaxed">
              Objective nozzle thermal windows ({filament.minNozzleTempC}–{filament.maxNozzleTempC}°C), heated bed parameters ({filament.minBedTempC}–{filament.maxBedTempC}°C), and max linear velocities across {combinations.length} 3D printers.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a
              href={buySpoolUrl}
              target="_blank"
              rel="noopener noreferrer sponsored"
              class="text-center bg-neutral-950 hover:bg-neutral-800 text-white font-medium px-4 py-2 text-sm uppercase tracking-wider font-mono transition-none"
            >
              Buy {filament.name} (1kg) on Amazon ↗
            </a>
            {filament.isHygroscopic && (
              <a
                href={dryerUrl}
                target="_blank"
                rel="noopener noreferrer sponsored"
                class="text-center border border-neutral-950 bg-white hover:bg-neutral-100 text-neutral-950 font-medium px-4 py-2 text-sm uppercase tracking-wider font-mono transition-none"
              >
                70°C Filament Dryer Box ↗
              </a>
            )}
          </div>
        </div>

        <!-- 4-Column Polymer Spec Bar -->
        <div class="grid grid-cols-2 sm:grid-cols-4 divide-y sm:divide-y-0 divide-x divide-neutral-200 bg-neutral-50 font-mono tabular-nums">
          <div class="p-6">
            <span class="block text-[11px] uppercase text-neutral-500 mb-1">NOZZLE TEMP WINDOW</span>
            <div class="text-3xl font-bold text-neutral-950">
              {filament.minNozzleTempC}–{filament.maxNozzleTempC}°C
            </div>
          </div>
          <div class="p-6">
            <span class="block text-[11px] uppercase text-neutral-500 mb-1">BED TEMP WINDOW</span>
            <div class="text-3xl font-bold text-neutral-950">
              {filament.minBedTempC}–{filament.maxBedTempC}°C
            </div>
          </div>
          <div class="p-6">
            <span class="block text-[11px] uppercase text-neutral-500 mb-1">VOLUMETRIC FLOW CEILING</span>
            <div class="text-3xl font-bold text-emerald-700">
              {filament.volumetricFlowLimitMm3s} mm³/s
            </div>
          </div>
          <div class="p-6">
            <span class="block text-[11px] uppercase text-neutral-500 mb-1">CHAMBER REQUIREMENT</span>
            <div class="text-2xl font-bold text-neutral-950 uppercase">
              {filament.requiresEnclosure ? 'ENCLOSED REQ' : 'OPEN FRAME OK'}
            </div>
          </div>
        </div>
      </section>

      <!-- Typeable Filter & Printer Compatibility Matrix Table -->
      <section class="divide-y divide-neutral-200">
        <div class="p-6 bg-neutral-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <span class="bg-neutral-950 text-white font-mono uppercase text-xs px-2.5 py-1">
              HARDWARE COMPATIBILITY REGISTER
            </span>
            <h2 class="text-xl font-black text-neutral-950 uppercase tracking-tight mt-2">
              {combinations.length} Calibrated 3D Printers for {filament.name}
            </h2>
          </div>

          <div class="w-full sm:w-96">
            <label for="filament-printer-filter" class="block text-[10px] font-mono uppercase text-neutral-600 mb-1">
              TYPE TO FILTER PRINTERS (E.G. BAMBU, CREALITY, PRUSA, VORON)
            </label>
            <input
              id="filament-printer-filter"
              type="search"
              placeholder="TYPE TO SEARCH 3D PRINTERS..."
              class="w-full px-3.5 py-2.5 bg-white border-2 border-neutral-950 text-xs font-mono text-neutral-950 placeholder-neutral-400 focus:outline-none focus:border-orange-600"
            />
          </div>
        </div>

        <div class="overflow-x-auto bg-white">
          <table class="w-full text-left border-collapse divide-y divide-neutral-200">
            <thead>
              <tr class="bg-neutral-50 text-[11px] font-mono uppercase text-neutral-500 divide-x divide-neutral-200">
                <th class="py-3.5 px-4">3D Printer System</th>
                <th class="py-3.5 px-4">Stock Nozzle</th>
                <th class="py-3.5 px-4">Target Temp</th>
                <th class="py-3.5 px-4">Effective Flow</th>
                <th class="py-3.5 px-4">Safe Speed</th>
                <th class="py-3.5 px-4">Compatibility Status</th>
                <th class="py-3.5 px-4 text-right">Spec / Tooling</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-200 text-sm font-mono tabular-nums" id="filament-matrix-tbody">
              {combinations
                .sort((a, b) => Number(b.isGenerated) - Number(a.isGenerated))
                .map((item) => {
                  const nozzleAmazonUrl = `https://www.amazon.com/s?k=${encodeURIComponent(
                    item.printer.name + ' hardened steel nozzle 0.4mm'
                  )}&tag=${AFFILIATE_TAG}`;
                  return (
                    <tr
                      id={item.slug}
                      data-search={`${item.printer.name} ${item.printer.vendor} ${item.printer.defaultNozzleMaterial}`.toLowerCase()}
                      class="hover:bg-neutral-100 divide-x divide-neutral-200 transition-none"
                    >
                      <td class="py-3.5 px-4 font-sans font-bold text-neutral-950">
                        <div class="flex items-center gap-2">
                          {item.isGenerated && (
                            <span
                              class="inline-block w-2 h-2 bg-emerald-600 shrink-0"
                              title="Full Verified OrcaSlicer Spec Sheet"
                            ></span>
                          )}
                          <a
                            href={item.isGenerated ? withBase(`/${item.slug}/`) : withBase(`/printer/${item.printer.slug}/`)}
                            class="hover:text-orange-600 uppercase tracking-tight"
                          >
                            {item.printer.name}
                          </a>
                        </div>
                      </td>
                      <td class="py-3.5 px-4 text-xs uppercase text-neutral-700">
                        {item.printer.defaultNozzleMaterial}
                      </td>
                      <td class="py-3.5 px-4 text-xs">
                        <span class="font-bold text-neutral-950">{item.deterministicMath.recommendedNozzleTempC}°C</span>
                        <span class="text-neutral-400"> / </span>
                        <span class="text-neutral-700">{item.deterministicMath.recommendedBedTempC}°C</span>
                      </td>
                      <td class="py-3.5 px-4 text-xs font-bold text-emerald-700">
                        {item.deterministicMath.effectiveVolumetricFlowMm3s} mm³/s
                      </td>
                      <td class="py-3.5 px-4 text-xs font-bold text-neutral-950">
                        {item.deterministicMath.calculatedMaxPrintSpeedMmS} mm/s
                      </td>
                      <td class="py-3.5 px-4">
                        <div class="flex flex-wrap gap-1.5 text-[10px] uppercase">
                          {item.deterministicMath.requiresHardenedNozzleUpgrade ? (
                            <span class="border border-amber-600 bg-amber-50 text-amber-950 px-2 py-0.5 font-bold">
                              ⚠️ UPGRADE NOZZLE
                            </span>
                          ) : item.deterministicMath.enclosureWarning ? (
                            <span class="border border-red-600 bg-red-50 text-red-900 px-2 py-0.5 font-bold">
                              ENCLOSURE REQ
                            </span>
                          ) : (
                            <span class="bg-neutral-950 text-emerald-400 px-2 py-0.5">
                              ● OPTIMAL MATCH
                            </span>
                          )}
                        </div>
                      </td>
                      <td class="py-3.5 px-4 text-right">
                        <div class="inline-flex items-center gap-2">
                          {item.isGenerated ? (
                            <a
                              href={withBase(`/${item.slug}/`)}
                              class="bg-neutral-950 hover:bg-neutral-800 text-white font-medium px-3 py-1.5 text-xs uppercase tracking-wider transition-none"
                            >
                              SPEC SHEET →
                            </a>
                          ) : (
                            <a
                              href={withBase(`/printer/${item.printer.slug}/`)}
                              class="border border-neutral-400 bg-white hover:bg-neutral-200 text-neutral-900 px-3 py-1.5 text-xs uppercase tracking-wider transition-none"
                            >
                              PRINTER HUB
                            </a>
                          )}
                          {item.deterministicMath.requiresHardenedNozzleUpgrade && (
                            <a
                              href={nozzleAmazonUrl}
                              target="_blank"
                              rel="noopener noreferrer sponsored"
                              class="bg-neutral-950 hover:bg-neutral-800 text-white font-medium px-3 py-1.5 text-xs uppercase tracking-wider transition-none"
                            >
                              NOZZLE ↗
                            </a>
                          )}
                        </div>
                      </td>
                    </tr>
                  );
                })}
            </tbody>
          </table>
        </div>
      </section>

      <!-- All Filaments Index Mesh -->
      <section class="p-6 sm:p-8 bg-neutral-50">
        <h2 class="text-xs font-mono uppercase tracking-widest text-neutral-500 mb-4">
          CROSS-REFERENCE // OTHER CALIBRATED POLYMER SPOOLS
        </h2>
        <div class="flex flex-wrap gap-2">
          {allFilaments.map((f) => (
            <a
              href={withBase(`/filament/${f.slug}/`)}
              class={`px-3 py-1.5 text-xs font-mono uppercase border transition-none ${
                f.slug === filament.slug
                  ? 'bg-neutral-950 text-white border-neutral-950 font-bold'
                  : 'bg-white text-neutral-900 border-neutral-300 hover:border-neutral-950'
              }`}
            >
              {f.name}
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>

  <script>
    const filterInput = document.getElementById('filament-printer-filter') as HTMLInputElement | null;
    const rows = document.querySelectorAll('#filament-matrix-tbody tr');
    if (filterInput) {
      filterInput.addEventListener('input', () => {
        const q = filterInput.value.trim().toLowerCase();
        rows.forEach((row) => {
          const hay = row.getAttribute('data-search') || '';
          (row as HTMLElement).style.display = hay.includes(q) ? '' : 'none';
        });
      });
    }
  </script>
</BaseLayout>
