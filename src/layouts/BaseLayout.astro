---
import { SITE_NAME, SITE_URL } from '../config';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p: string) => `${BASE}${p.startsWith('/') ? p : '/' + p}`;

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, SITE_URL).toString();
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE_NAME} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <style is:global>
      /* Clean Dieter Rams / Teenage Engineering Tactile Slider */
      input[type='range'].swiss-slider {
        -webkit-appearance: none;
        appearance: none;
        background: transparent;
        cursor: pointer;
      }
      input[type='range'].swiss-slider::-webkit-slider-runnable-track {
        height: 8px;
        background: #e5e5e5;
        border-radius: 999px;
      }
      input[type='range'].swiss-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 22px;
        height: 22px;
        background: #ea580c;
        border: 3px solid #ffffff;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
        margin-top: -7px;
        border-radius: 999px;
        transition: transform 0.1s ease;
      }
      input[type='range'].swiss-slider::-webkit-slider-thumb:hover {
        transform: scale(1.12);
      }
      input[type='range'].swiss-slider::-moz-range-track {
        height: 8px;
        background: #e5e5e5;
        border-radius: 999px;
      }
      input[type='range'].swiss-slider::-moz-range-thumb {
        width: 22px;
        height: 22px;
        background: #ea580c;
        border: 3px solid #ffffff;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
        border-radius: 999px;
      }
    </style>
  </head>
  <body class="bg-neutral-50 text-neutral-950 font-sans tracking-tight antialiased selection:bg-orange-500 selection:text-white min-h-screen flex flex-col">
    <!-- Minimalist Top Navigation -->
    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-neutral-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href={withBase('/')} class="flex items-center gap-2.5">
          <span class="w-4 h-4 rounded-sm bg-orange-600 inline-block"></span>
          <span class="font-extrabold text-lg tracking-tight text-neutral-950">SlicerMatrix</span>
        </a>

        <nav class="flex items-center gap-5 sm:gap-7 text-sm font-medium text-neutral-600">
          <a href={withBase('/#verified-profiles')} class="hover:text-neutral-950 transition-colors">Profiles</a>
          <a href={withBase('/#printers')} class="hover:text-neutral-950 transition-colors">Printers</a>
          <a href={withBase('/#filaments')} class="hover:text-neutral-950 transition-colors">Filaments</a>
          <a
            href={withBase('/bambu-lab-p1s-polymaker-polylite-petg-settings/')}
            class="hidden sm:inline-flex items-center gap-1.5 bg-neutral-950 hover:bg-neutral-800 text-white text-xs font-mono uppercase tracking-wider px-3.5 py-2 transition-colors"
          >
            Sample Profile
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Clean Minimal Footer -->
    <footer class="border-t border-neutral-200 bg-white mt-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-neutral-500">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 bg-neutral-950 inline-block"></span>
          <span class="font-semibold text-neutral-900">SlicerMatrix</span>
          <span>— 3D Printer × Filament OrcaSlicer Settings</span>
        </div>
        <div class="flex flex-wrap gap-5 text-neutral-600 font-medium">
          <a href={withBase('/printer/bambu-lab-p1s/')} class="hover:text-neutral-950">Bambu P1S</a>
          <a href={withBase('/printer/bambu-lab-a1/')} class="hover:text-neutral-950">Bambu A1</a>
          <a href={withBase('/printer/creality-k1-max/')} class="hover:text-neutral-950">Creality K1 Max</a>
          <a href={withBase('/filament/polymaker-polylite-petg/')} class="hover:text-neutral-950">PolyLite PETG</a>
          <a href={withBase('/filament/bambu-pla-cf/')} class="hover:text-neutral-950">Bambu PLA-CF</a>
        </div>
      </div>
    </footer>
  </body>
</html>
